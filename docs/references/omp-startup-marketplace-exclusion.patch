+export interface StartupMarketplaceOwner {
+	readonly kind: "startup-marketplace";
+}
+let scheduleStarts = 0;
+let startupMarketplace:
+	| { handle: StartupMarketplaceOwner; phase: "open" | "closed"; seen: boolean; violated: boolean }
+	| undefined;
+
+/** Own this opt-in disabled profile before any schedule call. */
+export function ownStartupMarketplace(): StartupMarketplaceOwner {
+	if (startupMarketplace || scheduleStarts) throw new Error("Startup marketplace ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-marketplace" as const });
+	startupMarketplace = { handle, phase: "open", seen: false, violated: false };
+	return handle;
+}
+export function isStartupMarketplace(handle: unknown): handle is StartupMarketplaceOwner {
+	return !!startupMarketplace && startupMarketplace.handle === handle && startupMarketplace.phase === "open";
+}
+/** The original off operation returns synchronously before importing the refresh. */
+export function retireStartupMarketplace(handle: unknown) {
+	const owner = startupMarketplace;
+	if (!owner || owner.handle !== handle || owner.phase !== "open" || !owner.seen || owner.violated)
+		throw new Error("Startup marketplace identity or state mismatch");
+	owner.phase = "closed";
+	return Object.freeze({ marketplace_disabled: true as const, schedule_completed: true as const });
+}
+
 export function scheduleMarketplaceAutoUpdate(options: MarketplaceAutoUpdateOptions): void {
+	const owner = startupMarketplace;
+	scheduleStarts = Math.min(2, scheduleStarts + 1);
+	if (owner) {
+		if (owner.phase !== "open" || owner.seen) {
+			if (owner.phase === "open") owner.violated = true;
+			throw new Error("Startup marketplace scheduling is closed");
+		}
+		const mode = Object.getOwnPropertyDescriptor(options, "autoUpdate");
+		if (!mode || !("value" in mode) || mode.value !== "off" || !Object.isFrozen(options))
+			throw new Error("Startup marketplace requires an explicit disabled setting");
+		scheduleOriginalMarketplaceAutoUpdate(options);
+		owner.seen = true;
+		return;
+	}
+	scheduleOriginalMarketplaceAutoUpdate(options);
+}
+function scheduleOriginalMarketplaceAutoUpdate(options: MarketplaceAutoUpdateOptions): void {
 	if (options.autoUpdate === "off") {
 		return;
 	}
