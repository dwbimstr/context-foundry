diff --git a/packages/coding-agent/test/startup-marketplace-owner.test.ts b/packages/coding-agent/test/startup-marketplace-owner.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/startup-marketplace-owner.test.ts
@@ -0,0 +1,94 @@
+import { expect, test } from "bun:test";
+const load = async (): Promise<typeof import("../src/extensibility/plugins/marketplace-auto-update")> =>
+	import("../src/extensibility/plugins/marketplace-auto-update.ts?case=" + crypto.randomUUID());
+const options = () =>
+	Object.freeze({
+		autoUpdate: "off" as const,
+		resolveActiveProjectRegistryPath: async () => {
+			throw Error("must not reach registry");
+		},
+		clearPluginRootsCache: () => {
+			throw Error("must not clear cache");
+		},
+	});
+test("owned original off scheduling completes and captured late references cannot start refresh", async () => {
+	const m = await load(),
+		captured = m.scheduleMarketplaceAutoUpdate,
+		owner = m.ownStartupMarketplace();
+	captured(options());
+	expect(m.retireStartupMarketplace(owner)).toEqual({ marketplace_disabled: true, schedule_completed: true });
+	expect(() => captured({ ...options(), autoUpdate: "notify" })).toThrow("closed");
+	expect(() => captured(options())).toThrow("closed");
+	expect(() => m.retireStartupMarketplace(owner)).toThrow("state");
+});
+test("enabled and accessor modes refuse before inspecting a getter or starting refresh", async () => {
+	const m = await load(),
+		owner = m.ownStartupMarketplace();
+	let reads = 0;
+	const malicious = {
+		get autoUpdate() {
+			reads++;
+			return "off" as const;
+		},
+		resolveActiveProjectRegistryPath: async () => null,
+		clearPluginRootsCache: () => {},
+	};
+	expect(() => m.scheduleMarketplaceAutoUpdate(malicious)).toThrow("disabled");
+	expect(reads).toBe(0);
+	expect(() => m.scheduleMarketplaceAutoUpdate({ ...options(), autoUpdate: "notify" })).toThrow("disabled");
+	expect(() => m.scheduleMarketplaceAutoUpdate({ ...options() })).toThrow("disabled");
+	m.scheduleMarketplaceAutoUpdate(options());
+	expect(m.retireStartupMarketplace(owner).schedule_completed).toBe(true);
+});
+test("a proxy cannot validate off and then turn the original operation on", async () => {
+	const m = await load(),
+		owner = m.ownStartupMarketplace();
+	let reads = 0;
+	const value = { ...options() };
+	const proxy = new Proxy(value, {
+		get(target, key, receiver) {
+			if (key === "autoUpdate") {
+				reads++;
+				return "notify";
+			}
+			return Reflect.get(target, key, receiver);
+		},
+	});
+	expect(() => m.scheduleMarketplaceAutoUpdate(proxy)).toThrow("disabled");
+	expect(reads).toBe(0);
+	m.scheduleMarketplaceAutoUpdate(options());
+	expect(m.retireStartupMarketplace(owner).marketplace_disabled).toBe(true);
+});
+test("forged, late, repeated and ambiguous owners cannot attest", async () => {
+	const m = await load(),
+		owner = m.ownStartupMarketplace();
+	expect(() => m.ownStartupMarketplace()).toThrow("repeated");
+	expect(() => m.retireStartupMarketplace({ kind: "startup-marketplace" })).toThrow("state");
+	m.scheduleMarketplaceAutoUpdate(options());
+	expect(() => m.scheduleMarketplaceAutoUpdate(options())).toThrow("closed");
+	expect(() => m.retireStartupMarketplace(owner)).toThrow("state");
+	const n = await load();
+	n.scheduleMarketplaceAutoUpdate(options());
+	expect(() => n.ownStartupMarketplace()).toThrow("late");
+});
+test("the SDK refuses a forged marketplace owner before initialization", async () => {
+	const { createAgentSession } = await import("../src/sdk");
+	await expect(
+		createAgentSession({ restrictToolNames: true, startupMarketplaceOwner: { kind: "startup-marketplace" } }),
+	).rejects.toThrow("exact restricted CLI owner");
+});
+test("the opt-in flag is valueless", async () => {
+	const { parseArgs } = await import("../src/cli/args"),
+		{ VALUELESS_FLAGS } = await import("../src/cli/flag-tables");
+	const a = parseArgs([
+		"--startup-no-marketplace",
+		"--model",
+		"synthetic/model",
+		"--restrict-tools",
+		"--tools",
+		"read,edit",
+	]);
+	expect(a.startupNoMarketplace).toBe(true);
+	expect(a.model).toBe("synthetic/model");
+	expect(VALUELESS_FLAGS.has("--startup-no-marketplace")).toBe(true);
+});
