+/** Retire the exact source-owned disabled marketplace scheduler after telemetry. */
+export async function retireRestrictedStartupMarketplace(sessionManager: unknown, modelRegistry: unknown) {
+	const owner = restrictedOwner,
+		session = owner?.session.deref(),
+		registry = owner?.registry.deref(),
+		marketplace = owner?.marketplace?.deref();
+	if (
+		!restrictedSealed ||
+		restrictedStarts !== 1 ||
+		!owner?.telemetryRetired ||
+		!session ||
+		session.isDisposed ||
+		session.sessionManager !== sessionManager ||
+		!registry ||
+		registry !== modelRegistry ||
+		!marketplace
+	)
+		throw new Error("Restricted marketplace owner identity or state mismatch");
+	return retireStartupMarketplace(marketplace);
 }
 
