@@ -0,0 +1,113 @@
+import { afterEach, expect, spyOn, test } from "bun:test";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { Settings } from "../src/config/settings";
+const roots: string[] = [];
+afterEach(() => {
+	for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true });
+});
+async function fixture(owned = true) {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "omp-settings-owner-"));
+	roots.push(root);
+	const agentDir = path.join(root, "agent"),
+		cwd = path.join(root, "first"),
+		next = path.join(root, "next");
+	for (const dir of [agentDir, cwd, next]) fs.mkdirSync(dir, { recursive: true });
+	fs.writeFileSync(path.join(agentDir, "config.yml"), "retry:\n  enabled: false\n");
+	const settings = await Settings.loadIsolated({ cwd, agentDir, ownStartupPersistence: owned });
+	return { settings, root, agentDir, cwd, next };
+}
+async function turns() {
+	for (let i = 0; i < 20; i++) await Promise.resolve();
+}
+test("retirement joins an original reload and queued rescope before closing persistence", async () => {
+	const f = await fixture();
+	const entered = Promise.withResolvers<void>(),
+		release = Promise.withResolvers<void>(),
+		queuedEntered = Promise.withResolvers<void>(),
+		queuedRelease = Promise.withResolvers<void>();
+	const read = fs.promises.readFile;
+	let held = false;
+	const spy = spyOn(fs.promises, "readFile").mockImplementation((async (...args: Parameters<typeof read>) => {
+		const original = Reflect.apply(read, fs.promises, args);
+		if (!held && String(args[0]) === path.join(f.agentDir, "config.yml")) {
+			held = true;
+			entered.resolve();
+			await release.promise;
+		}
+		if (String(args[0]) === path.join(f.next, ".omp/config.yml")) {
+			queuedEntered.resolve();
+			await queuedRelease.promise;
+		}
+		return await original;
+	}) as typeof read);
+	try {
+		const original = f.settings.reloadFromDisk();
+		await entered.promise;
+		const queued = f.settings.reloadForCwd(f.next);
+		let done = false;
+		const retirement = f.settings.retireStartupPersistence().then(r => {
+			done = true;
+			return r;
+		});
+		await turns();
+		expect(done).toBe(false);
+		expect(f.settings.getCwd()).toBe(f.cwd);
+		expect(() => f.settings.reloadFromDisk()).toThrow("retired");
+		release.resolve();
+		await queuedEntered.promise;
+		await turns();
+		expect(done).toBe(false);
+		queuedRelease.resolve();
+		await Promise.all([original, queued]);
+		const receipt = await retirement;
+		expect(f.settings.getCwd()).toBe(f.next);
+		expect(receipt.originals_joined).toBe(true);
+		expect(receipt.callbacks_joined).toBe(true);
+		expect(receipt.operations).toBeGreaterThanOrEqual(4);
