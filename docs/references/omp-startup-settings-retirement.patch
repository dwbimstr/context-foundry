+
+/** Retire the original CLI auth/settings link and exact settings persistence owner. */
+export async function retireRestrictedStartupSettings(sessionManager: unknown, modelRegistry: unknown) {
+	const owner = restrictedOwner,
+		session = owner?.session.deref(),
+		registry = owner?.registry.deref();
+	if (
+		!restrictedSealed ||
+		restrictedStarts !== 1 ||
+		!session ||
+		session.isDisposed ||
+		session.sessionManager !== sessionManager ||
+		!registry ||
+		registry !== modelRegistry ||
+		session.settings !== Settings.instance
+	)
+		throw new Error("Restricted settings owner identity mismatch");
+	const link = bindCliAuthStorageSettingsSync(session.settings);
+	const auth = await link.retire(registry.authStorage);
+	if (auth.initial_resolver_joined !== true || auth.chain_joined !== true)
+		throw new Error("Restricted auth/settings link did not retire");
+	return Object.freeze({
+		auth_listener_retired: true as const,
+		...(await session.settings.retireStartupPersistence()),
+	});
 }
 
