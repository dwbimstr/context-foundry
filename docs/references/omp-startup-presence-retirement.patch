+/** Opaque identity for the one explicitly owned CLI presence lifetime. */
+export interface StartupDaemonPresence {
+	readonly kind: "startup-daemon-presence";
+}
+export interface StartupDaemonPresenceReceipt {
+	readonly presence_retired: true;
+	readonly registration_joined: true;
+	readonly callbacks_joined: true;
+	readonly cleanup_joined: true;
+	readonly presence_removed: true;
+}
+let presenceStarts = 0;
+let startupPresence:
+	| {
+			handle: StartupDaemonPresence;
+			phase: "open" | "closing" | "closed";
+			original?: Promise<DaemonProjectPresence>;
+			observer?: Promise<void>;
+			violated: boolean;
+	  }
+	| undefined;
+
+/** Must precede every registration, including calls through previously captured exports. */
+export function ownStartupDaemonPresence(): StartupDaemonPresence {
+	if (startupPresence || presenceStarts) throw new Error("Startup presence ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-daemon-presence" as const });
+	startupPresence = { handle, phase: "open", violated: false };
+	return handle;
+}
+export function isStartupDaemonPresence(handle: unknown): handle is StartupDaemonPresence {
+	return (
+		!!startupPresence &&
+		startupPresence.handle === handle &&
+		startupPresence.phase === "open" &&
+		!!startupPresence.original
+	);
+}
+
+/** Refuse new registration before any path resolution or filesystem work. */
+export function registerDaemonProjectPresence(
+	projectDir: string,
+	runtimeOverride?: string,
+): Promise<DaemonProjectPresence> {
+	const owner = startupPresence;
+	presenceStarts = Math.min(2, presenceStarts + 1);
+	if (owner && (owner.phase !== "open" || owner.original)) {
+		if (owner.phase === "open") owner.violated = true;
+		return Promise.reject(new Error("Startup presence registration is closed"));
+	}
+	const original = registerOriginalDaemonProjectPresence(projectDir, runtimeOverride);
+	if (owner) {
+		owner.original = original;
+		owner.observer = original.then(
+			() => {},
+			() => {},
+		);
+	}
+	return original;
+}
+
+/** Join original registration, its observer and whichever caller first began close. */
+export async function retireStartupDaemonPresence(handle: unknown): Promise<StartupDaemonPresenceReceipt> {
+	const owner = startupPresence;
+	if (!owner || owner.handle !== handle || owner.phase !== "open" || !owner.original || !owner.observer)
+		throw new Error("Startup presence identity or state mismatch");
+	owner.phase = "closing";
+	const [registered] = await Promise.allSettled([owner.original, owner.observer]);
+	if (owner.violated || registered.status !== "fulfilled")
+		throw new Error("Startup presence registration did not qualify");
+	await registered.value.close();
+	owner.phase = "closed";
+	return Object.freeze({
+		presence_retired: true,
+		registration_joined: true,
+		callbacks_joined: true,
+		cleanup_joined: true,
+		presence_removed: true,
+	});
+}
