+import { afterEach, expect, test } from "bun:test";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { postmortem } from "@oh-my-pi/pi-utils";
+const nativeRm = fs.rm,
+	nativeWrite = Bun.write,
+	nativeChmod = fs.chmod;
+const roots: string[] = [];
+const load = async (): Promise<typeof import("../src/launch/presence")> =>
+	import("../src/launch/presence.ts?case=" + crypto.randomUUID());
+const deferred = () => {
+	let resolve!: () => void;
+	const promise = new Promise<void>(r => {
+		resolve = r;
+	});
+	return { promise, resolve };
+};
+async function scope() {
+	const root = await fs.mkdtemp(path.join(os.tmpdir(), "owned-presence-"));
+	roots.push(root);
+	const cwd = path.join(root, "project");
+	await fs.mkdir(cwd);
+	return { cwd, runtime: path.join(root, "runtime") };
+}
+async function presenceFiles(runtime: string) {
+	try {
+		return await fs.readdir(path.join(runtime, "clients"));
+	} catch {
+		return [];
+	}
+}
+afterEach(async () => {
+	fs.rm = nativeRm;
+	fs.chmod = nativeChmod;
+	Bun.write = nativeWrite;
+	for (const root of roots.splice(0)) await nativeRm(root, { recursive: true, force: true });
+});
+
+test("ordinary registration keeps a real private presence until original cleanup", async () => {
+	const m = await load(),
+		s = await scope();
+	const presence = await m.registerDaemonProjectPresence(s.cwd, s.runtime);
+	const names = await presenceFiles(s.runtime);
+	expect(names).toHaveLength(1);
+	const file = path.join(s.runtime, "clients", names[0]);
+	expect((await fs.stat(file)).mode & 0o777).toBe(0o600);
+	expect((await Bun.file(file).json()).pid).toBe(process.pid);
+	await presence.close();
+	expect(await presenceFiles(s.runtime)).toEqual([]);
+});
+test("concurrent captured close calls return and join the exact original removal promise", async () => {
+	const m = await load(),
+		s = await scope(),
+		presence = await m.registerDaemonProjectPresence(s.cwd, s.runtime),
+		held = deferred(),
+		started = deferred();
+	let removes = 0;
+	fs.rm = (async (file, options) => {
+		if (String(file).includes("/clients/")) {
+			removes++;
+			started.resolve();
+			await held.promise;
+		}
+		return await nativeRm(file, options);
+	}) as typeof fs.rm;
+	const close = presence.close,
+		one = close();
+	await started.promise;
+	const two = close();
+	expect(two).toBe(one);
+	let done = false;
+	two.then(() => {
+		done = true;
+	});
+	await Bun.sleep(20);
+	expect(done).toBe(false);
+	expect(await presenceFiles(s.runtime)).toHaveLength(1);
+	held.resolve();
+	await one;
+	await two;
+	expect(removes).toBe(1);
+	expect(await presenceFiles(s.runtime)).toEqual([]);
+	await postmortem.cleanup();
+	expect(removes).toBe(1);
+});
