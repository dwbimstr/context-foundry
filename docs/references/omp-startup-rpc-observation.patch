+
+type StartupRpcReceipt = Readonly<{
+	initial_catalog_joined: true;
+	metadata_subscription_excluded: true;
+	output_drained: true;
+	dispatch_closed: true;
+}>;
+
+let startupRpcIssued = false;
+let pendingStartupRpcReceipt: StartupRpcReceipt | undefined;
+
+export function consumeStartupRpcReceipt(proof: unknown): StartupRpcReceipt {
+	const receipt = pendingStartupRpcReceipt;
+	if (!receipt || proof !== receipt) throw new Error("Invalid RPC startup receipt");
+	pendingStartupRpcReceipt = undefined;
+	return receipt;
+}
+
+function reportStartupRpcRetired(): void {
+	const notify = (globalThis as Record<symbol, unknown>)[Symbol.for("context-foundry.startup.rpc-retired.v1")];
+	if (startupRpcIssued || typeof notify !== "function") throw new Error("RPC startup observer unavailable");
+	startupRpcIssued = true;
+	const receipt: StartupRpcReceipt = Object.freeze({
+		initial_catalog_joined: true,
+		metadata_subscription_excluded: true,
+		output_drained: true,
+		dispatch_closed: true,
+	});
+	pendingStartupRpcReceipt = receipt;
+	try {
+		notify(receipt);
+		if (pendingStartupRpcReceipt) throw new Error("RPC startup receipt not consumed");
+	} finally {
+		pendingStartupRpcReceipt = undefined;
+	}
 }
 
