+test("restricted ownership refuses deferred credential and MCP notifications before dispatch", () => {
+	const v = run(`
+  const credential={provider:'synthetic',disabledCause:'synthetic'},mcp={server:'synthetic',method:'notifications/synthetic',params:{}};
+  void runner.emitCredentialDisabled(credential);void runner.emitMcpNotification(mcp);
+  runner.initialize({},{},undefined,undefined,'rpc');await new Promise(r=>setTimeout(r,10));const flushed=[...notified];
+  await runner.emitCredentialDisabled(credential);await runner.emitMcpNotification(mcp);
+  handler=async()=>{r.readyStartupExtension(owner,runner)};await runner.emit({type:'session_start'});
+  await new Promise(r=>setTimeout(r,30));console.log(JSON.stringify({flushed,notified,receipt}));auth.close();
+ `);
+	expect(v.flushed).toEqual([]);
+	expect(v.notified).toEqual([]);
+	expect(v.receipt.notifications_excluded).toBe(true);
+});
+const bufferBeforeBind = `void runner.emitCredentialDisabled({provider:'synthetic',disabledCause:'synthetic'});void runner.emitMcpNotification({server:'synthetic',method:'notifications/synthetic',params:{}});`;
+test("restricted ownership drops notifications buffered before the bind without dispatch at initialize", () => {
+	const v = run(
+		`
+  runner.initialize({},{},undefined,undefined,'rpc');await new Promise(r=>setTimeout(r,10));const flushed=[...notified];
+  handler=async()=>{r.readyStartupExtension(owner,runner)};await runner.emit({type:'session_start'});
+  await new Promise(r=>setTimeout(r,30));console.log(JSON.stringify({flushed,notified,receipt}));auth.close();
+ `,
+		bufferBeforeBind,
+	);
+	expect(v.flushed).toEqual([]);
+	expect(v.notified).toEqual([]);
+	expect(v.receipt?.notifications_excluded).toBe(true);
+});
+test("restricted session_start fails closed while notifications buffered before the bind remain", () => {
+	const v = run(
+		`
+  handler=async()=>{r.readyStartupExtension(owner,runner)};let error=null;
+  try{await runner.emit({type:'session_start'})}catch(e){error=e instanceof Error?e.message:String(e)}
+  await new Promise(r=>setTimeout(r,30));console.log(JSON.stringify({error,notified,receipt}));auth.close();
+ `,
+		bufferBeforeBind,
