  * The previous file transport writes its buffered records before closing, and
  * the file level (`OMP_LOG_LEVEL`) is re-read on each reconfiguration.
  */
+export interface StartupLoggingOwner {
+	readonly kind: "startup-logging";
+}
+let startupLogging: { handle: StartupLoggingOwner; phase: "open" | "closing" | "closed" | "failed" } | undefined;
+
+/** Own this module's local logger before restricted startup can reconfigure it. */
+export function ownStartupLogging(): StartupLoggingOwner {
+	if (startupLogging || logForwarder || logSinks.size)
+		throw new Error("Startup logging ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-logging" as const });
+	startupLogging = { handle, phase: "open" };
+	try {
+		setTransportsOriginal({ console: false, file: false });
+	} catch (error) {
+		startupLogging.phase = "failed";
+		throw error;
+	}
+	return handle;
+}
+export function isStartupLogging(handle: unknown): handle is StartupLoggingOwner {
+	return !!startupLogging && startupLogging.handle === handle && startupLogging.phase === "open";
+}
+/** Close admission and join the original already-queued retention callbacks. */
+export async function retireStartupLogging(handle: unknown) {
+	const owner = startupLogging;
+	if (!owner || owner.handle !== handle || owner.phase !== "open")
+		throw new Error("Startup logging identity or state mismatch");
+	owner.phase = "closing";
+	for (const immediate of pendingPruneHandles) immediate.ref();
+	await Promise.all([...pendingPruneCallbacks]);
+	if (
+		pruneCallbackFailed ||
+		pendingPruneCallbacks.size ||
+		logForwarder ||
+		logSinks.size ||
+		activeTransports?.file ||
+		activeTransports?.console
+	) {
+		owner.phase = "failed";
+		throw new Error("Startup logging remained active");
+	}
+	owner.phase = "closed";
+	return Object.freeze({
+		logging_closed: true as const,
+		transport_closed: true as const,
+		retention_joined: true as const,
+	});
+}
 export function setTransports(opts: { console?: boolean; file?: boolean | string }): void {
+	if (startupLogging) throw new Error("Startup logging transports are closed");
+	setTransportsOriginal(opts);
+}
