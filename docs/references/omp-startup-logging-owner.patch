new file mode 100644
--- /dev/null
+++ b/packages/utils/test/startup-logging-owner.test.ts
@@ -0,0 +1,77 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const loggerPath = join(import.meta.dir, "../src/logger.ts");
+function run(code: string) {
+	const dir = mkdtempSync(join(tmpdir(), "foundry-logger-test-"));
+	try {
+		const p = Bun.spawnSync(
+			[
+				process.execPath,
+				"-e",
+				`import * as logger from ${JSON.stringify(loggerPath)};\nconst dir=${JSON.stringify(dir)};\n${code}`,
+			],
+			{ stdout: "pipe", stderr: "pipe" },
+		);
+		if (p.exitCode !== 0) throw new Error(p.stderr.toString());
+		return JSON.parse(p.stdout.toString());
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+}
+test("owns and joins actual native logger and rejects late cached entry points", () => {
+	const out = run(`
+  const fs = await import('node:fs'); const path = await import('node:path');
+  const cachedTransport = logger.setTransports, cachedSink = logger.registerLogSink, cachedForwarder = logger.setLogForwarder;
+  cachedTransport({file:dir,console:false}); logger.info('BEFORE');
+  const owner = logger.ownStartupLogging();
+  let wrong=false,duplicate=false,transport=false,sink=false,forwarder=false,late=false;
+  try {await logger.retireStartupLogging({kind:'startup-logging'});} catch {wrong=true;}
+  const result = await logger.retireStartupLogging(owner);
+  try {await logger.retireStartupLogging(owner);} catch {duplicate=true;}
+  try {cachedTransport({file:dir});} catch {transport=true;}
+  try {cachedSink(()=>{});} catch {sink=true;}
+  try {cachedForwarder({emit(){},flush(){}});} catch {forwarder=true;}
+  try {logger.ownStartupLogging();} catch {late=true;}
+  logger.warn('AFTER');
+  const contents=fs.readdirSync(dir).map(f=>fs.readFileSync(path.join(dir,f),'utf8')).join('');
+  console.log(JSON.stringify({wrong,duplicate,transport,sink,forwarder,late,result,before:contents.includes('BEFORE'),after:contents.includes('AFTER')}));
+ `);
+	expect(out).toEqual({
+		wrong: true,
+		duplicate: true,
+		transport: true,
+		sink: true,
+		forwarder: true,
+		late: true,
+		result: { logging_closed: true, transport_closed: true, retention_joined: true },
+		before: true,
+		after: false,
+	});
+});
+test("ownership refuses an existing sink or forwarder without invoking either", () => {
+	for (const setup of [
+		"logger.registerLogSink(()=>{throw Error('called')})",
+		"logger.setLogForwarder({emit(){throw Error('called')},flush(){throw Error('called')}})",
+	]) {
+		const out = run(
+			`${setup}; let refused=false; try {logger.ownStartupLogging();} catch {refused=true;} console.log(JSON.stringify({refused}));`,
+		);
+		expect(out.refused).toBe(true);
+	}
+});
+
+test("retirement waits for the original held retention callback", () => {
+	const out = run(`
+  const original=globalThis.setImmediate; let held;
+  globalThis.setImmediate=(fn,...args)=>{held=()=>fn(...args);return {unref(){},ref(){}}};
+  logger.setTransports({file:dir,console:false}); logger.info('INITIALIZE'); globalThis.setImmediate=original;
+  const owner=logger.ownStartupLogging(); let settled=false;
+  const retirement=logger.retireStartupLogging(owner).then(()=>{settled=true});
+  await new Promise(resolve=>setTimeout(resolve,10)); const before=settled;
+  held(); await retirement; console.log(JSON.stringify({before,after:settled}));
+ `);
+	expect(out).toEqual({ before: false, after: true });
+});
