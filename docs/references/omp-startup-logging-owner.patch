+import { expect, test } from "bun:test";
+test("logging owner flag is valueless", async () => {
+	const { parseArgs } = await import("../src/cli/args");
+	const { VALUELESS_FLAGS } = await import("../src/cli/flag-tables");
+	const args = parseArgs([
+		"--startup-no-logging",
+		"--model",
+		"synthetic/model",
+		"--restrict-tools",
+		"--tools",
+		"read,edit",
+	]);
+	expect(args.startupNoLogging).toBe(true);
+	expect(args.model).toBe("synthetic/model");
+	expect(VALUELESS_FLAGS.has("--startup-no-logging")).toBe(true);
+});
+test("forged logging owner cannot initialize SDK", async () => {
+	const { createAgentSession } = await import("../src/sdk");
+	await expect(
+		createAgentSession({ restrictToolNames: true, startupLoggingOwner: { kind: "startup-logging" } }),
+	).rejects.toThrow("exact restricted CLI owner");
+});
