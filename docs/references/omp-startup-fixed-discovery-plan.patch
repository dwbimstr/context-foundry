+test("fixed startup latches an unreadable or widened live discovery profile before provider preflight", async () => {
+	for (const unreadable of [false, true]) {
+		const f = fixture(true, true, { modelConfig: "providers:\n  anthropic:\n    auth: none\n" });
+		try {
+			const peek = spyOn(f.auth.keys, "peek");
+			const read = unreadable
+				? spyOn(cfgDisabledProviders, "get").mockImplementation(() => {
+						throw new Error("fixture unavailable");
+					})
