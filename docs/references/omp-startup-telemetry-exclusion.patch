-export async function initTelemetryExport(exportEnabled: boolean): Promise<void> {
+export function initTelemetryExport(exportEnabled: boolean): Promise<void> {
+	const owner = startupTelemetry;
+	telemetryStarts = Math.min(2, telemetryStarts + 1);
+	if (owner && (owner.phase !== "open" || owner.original || exportEnabled)) {
+		if (owner.phase === "open" && owner.original) owner.violated = true;
+		return Promise.reject(new Error("Startup telemetry export is closed"));
+	}
+	const original = initOriginalTelemetryExport(exportEnabled);
+	if (owner) {
+		owner.original = original;
+		owner.observer = original.then(
+			() => {},
+			() => {},
+		);
+	}
+	return original;
+}
+async function initOriginalTelemetryExport(exportEnabled: boolean): Promise<void> {
 	if (initPromise) return initPromise;
 
 	if (!exportEnabled || process.env.OTEL_SDK_DISABLED?.trim().toLowerCase() === "true") return;
diff --git a/packages/coding-agent/test/startup-telemetry-owner.test.ts b/packages/coding-agent/test/startup-telemetry-owner.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/startup-telemetry-owner.test.ts
@@ -0,0 +1,111 @@
+import { expect, test } from "bun:test";
+const load = async (): Promise<typeof import("../src/telemetry-export")> =>
+	import("../src/telemetry-export.ts?case=" + crypto.randomUUID());
+test("owned disabled initialization remains disabled despite a configured endpoint and captured late calls", async () => {
+	const m = await load(),
+		captured = m.initTelemetryExport,
+		owner = m.ownStartupTelemetry();
+	process.env.OTEL_EXPORTER_OTLP_ENDPOINT = "http://127.0.0.1:9";
+	await expect(captured(true)).rejects.toThrow("closed");
+	await captured(false);
+	expect(m.isTelemetryExportEnabled()).toBe(false);
+	expect(await m.retireStartupTelemetry(owner)).toEqual({
+		telemetry_disabled: true,
+		original_joined: true,
+		callbacks_joined: true,
+	});
+	await expect(captured(true)).rejects.toThrow("closed");
+	await expect(captured(false)).rejects.toThrow("closed");
+	await expect(m.retireStartupTelemetry(owner)).rejects.toThrow("state");
+	delete process.env.OTEL_EXPORTER_OTLP_ENDPOINT;
+});
+test("wrong and forged owners cannot obtain the original receipt", async () => {
+	const m = await load(),
+		owner = m.ownStartupTelemetry();
+	await m.initTelemetryExport(false);
+	expect(m.isStartupTelemetry(owner)).toBe(true);
+	await expect(m.retireStartupTelemetry({ kind: "startup-telemetry" })).rejects.toThrow("identity");
+	await m.retireStartupTelemetry(owner);
+});
+test("late and repeated ownership refuse", async () => {
+	const m = await load();
+	await m.initTelemetryExport(false);
+	expect(() => m.ownStartupTelemetry()).toThrow("late");
+	const n = await load(),
+		owner = n.ownStartupTelemetry();
+	expect(() => n.ownStartupTelemetry()).toThrow("repeated");
+	await expect(n.retireStartupTelemetry(owner)).rejects.toThrow("state");
+});
+test("ambiguous duplicate initialization cannot yield a receipt", async () => {
+	const m = await load(),
+		owner = m.ownStartupTelemetry();
+	await m.initTelemetryExport(false);
+	await expect(m.initTelemetryExport(false)).rejects.toThrow("closed");
+	await expect(m.retireStartupTelemetry(owner)).rejects.toThrow("qualify");
+});
+test("the SDK rejects a forged owner before initialization", async () => {
+	const { createAgentSession } = await import("../src/sdk");
+	await expect(
+		createAgentSession({ restrictToolNames: true, startupTelemetryOwner: { kind: "startup-telemetry" } }),
+	).rejects.toThrow("exact restricted CLI owner");
+});
+test("the opt-in flag is valueless", async () => {
+	const { parseArgs } = await import("../src/cli/args"),
+		{ VALUELESS_FLAGS } = await import("../src/cli/flag-tables");
+	const a = parseArgs([
+		"--startup-no-telemetry",
+		"--model",
+		"synthetic/model",
+		"--restrict-tools",
+		"--tools",
+		"read,edit",
+	]);
+	expect(a.startupNoTelemetry).toBe(true);
+	expect(a.model).toBe("synthetic/model");
+	expect(VALUELESS_FLAGS.has("--startup-no-telemetry")).toBe(true);
+});
+
+test("retirement joins the original completion observer", async () => {
+	const m = await load(),
+		owner = m.ownStartupTelemetry();
+	let release!: () => void;
+	const gate = new Promise<void>(resolve => {
+		release = resolve;
+	});
+	const nativeThen = Promise.prototype.then;
+	let captured = false;
+	try {
+		Promise.prototype.then = function (this: Promise<unknown>, onFulfilled, onRejected) {
+			if (!captured) {
+				captured = true;
+				return nativeThen.call(
+					this,
+					async value => {
+						await gate;
+						return onFulfilled?.(value);
+					},
+					onRejected,
+				);
+			}
+			return nativeThen.call(this, onFulfilled, onRejected);
+		} as typeof Promise.prototype.then;
+		m.initTelemetryExport(false);
+	} finally {
+		Promise.prototype.then = nativeThen;
+	}
+	expect(captured).toBe(true);
+	let settled = false;
+	const retirement = m.retireStartupTelemetry(owner);
+	retirement.then(
+		() => {
+			settled = true;
+		},
+		() => {
+			settled = true;
+		},
+	);
+	await Bun.sleep(20);
+	expect(settled).toBe(false);
+	release();
+	expect((await retirement).callbacks_joined).toBe(true);
+});
