diff --git a/packages/coding-agent/src/telemetry-export.ts b/packages/coding-agent/src/telemetry-export.ts
--- a/packages/coding-agent/src/telemetry-export.ts
+++ b/packages/coding-agent/src/telemetry-export.ts
@@ -41,6 +41,52 @@
 
 let otlp: OtlpExportModule | undefined;
 let initPromise: Promise<void> | undefined;
+export interface StartupTelemetryOwner {
+	readonly kind: "startup-telemetry";
+}
+let telemetryStarts = 0;
+let startupTelemetry:
+	| {
+			handle: StartupTelemetryOwner;
+			phase: "open" | "closing" | "closed";
+			original?: Promise<void>;
+			observer?: Promise<void>;
+			violated: boolean;
+	  }
+	| undefined;
+
+/** Own the explicit no-export profile before any initialization begins. */
+export function ownStartupTelemetry(): StartupTelemetryOwner {
+	if (startupTelemetry || telemetryStarts || initPromise || otlp)
+		throw new Error("Startup telemetry ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-telemetry" as const });
+	startupTelemetry = { handle, phase: "open", violated: false };
+	return handle;
+}
+export function isStartupTelemetry(handle: unknown): handle is StartupTelemetryOwner {
+	return (
+		!!startupTelemetry &&
+		startupTelemetry.handle === handle &&
+		startupTelemetry.phase === "open" &&
+		!!startupTelemetry.original
+	);
+}
+/** Only the exact owner may close admission and join the original no-export call. */
+export async function retireStartupTelemetry(handle: unknown) {
+	const owner = startupTelemetry;
+	if (!owner || owner.handle !== handle || owner.phase !== "open" || !owner.original || !owner.observer)
+		throw new Error("Startup telemetry identity or state mismatch");
+	owner.phase = "closing";
+	const results = await Promise.allSettled([owner.original, owner.observer]);
+	if (owner.violated || results.some(result => result.status !== "fulfilled") || initPromise || otlp)
+		throw new Error("Startup telemetry did not qualify");
+	owner.phase = "closed";
+	return Object.freeze({
+		telemetry_disabled: true as const,
+		original_joined: true as const,
+		callbacks_joined: true as const,
+	});
+}
 
 /**
  * Whether {@link initTelemetryExport} registered any real OTLP signal provider.
@@ -76,7 +122,24 @@
