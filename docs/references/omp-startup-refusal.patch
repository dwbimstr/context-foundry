 const PREWARM_TIMEOUT_MS = 10_000;
 
 const prewarmedAt = new Map<string, number>();
+
+/** A no-grant observer installed by an owned preload before the first call. */
+const startupRefusalKey = Symbol.for("omp.connection-prewarm.refusal.v1");
+type StartupRefusal = (
+	attempt: Readonly<{ owner: "model_connection_warmup"; method: "HEAD"; origin: string }>,
+) => Promise<void>;
+let refusalRead = false;
+let startupRefusal: StartupRefusal | undefined;
+function readStartupRefusal(): StartupRefusal | undefined {
+	const descriptor = Object.getOwnPropertyDescriptor(globalThis, startupRefusalKey);
+	const valid =
+		descriptor !== undefined &&
+		typeof descriptor.value === "function" &&
+		descriptor.writable === false &&
+		descriptor.configurable === false &&
+		!("get" in descriptor);
+	if (!refusalRead) {
+		refusalRead = true;
+		if (valid) startupRefusal = descriptor.value;
+	}
+	if (
+		(descriptor !== undefined && (!valid || descriptor.value !== startupRefusal)) ||
+		(descriptor === undefined && startupRefusal !== undefined)
+	) {
+		throw new Error("Invalid startup connection refusal binding");
+	}
+	return startupRefusal;
+}
 
