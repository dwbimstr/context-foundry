diff --git a/packages/ai/test/connection-prewarm-refusal.test.ts b/packages/ai/test/connection-prewarm-refusal.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/ai/test/connection-prewarm-refusal.test.ts
@@ -0,0 +1,51 @@
+import { expect, test } from "bun:test";
+const modulePath = new URL("../src/providers/connection-prewarm.ts", import.meta.url).pathname;
+const program = `
+import { prewarmModelConnection } from ${JSON.stringify(modulePath)};
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+delete Bun.env.ANTHROPIC_BASE_URL;
+const key = Symbol.for("omp.connection-prewarm.refusal.v1");
+let observed = 0, transported = 0, timed = 0, completed = false;
+const timeout = AbortSignal.timeout;
+AbortSignal.timeout = function(ms) { timed++; return timeout.call(AbortSignal,ms); };
+const model = buildModel({provider:"anthropic",api:"anthropic-messages",id:"claude-sonnet-5-5",name:"synthetic",baseUrl:"https://api.anthropic.com",reasoning:false,input:["text"],cost:{input:0,output:0,cacheRead:0,cacheWrite:0},contextWindow:200000,maxTokens:8192});
+const mode = process.argv[1];
+let release, reject;
+const held = new Promise((yes,no) => { release=yes; reject=no; });
+const observer = async metadata => { observed++; if (metadata.origin !== "https://api.anthropic.com" || metadata.method !== "HEAD" || metadata.owner !== "model_connection_warmup" || !Object.isFrozen(metadata)) throw Error("metadata"); await held; };
+if (mode !== "baseline" && mode !== "late") Object.defineProperty(globalThis,key,{value:observer,writable:mode === "mutable",configurable:false});
+if (mode === "late") { await prewarmModelConnection({...model,provider:"not-a-provider"}); Object.defineProperty(globalThis,key,{value:observer,writable:false,configurable:false}); }
+const original = prewarmModelConnection(model,{fetch:async () => { transported++; return new Response(null); }}).then(() => { completed=true; });
+await new Promise(resolve => setImmediate(resolve));
+const before = {observed,transported,timed,completed};
+if (mode === "reject") reject(new Error("not a transport permission")); else release();
+await original;
+console.log(JSON.stringify({before,observed,transported,timed,completed}));
+`;
+for (const mode of ["baseline", "resolve", "reject", "mutable", "late"]) {
+	test(`warm-up no-grant observer: ${mode}`, async () => {
+		const child = Bun.spawn([process.execPath, "-e", program, mode], {
+			stdout: "pipe",
+			stderr: "pipe",
+			env: { ...process.env, ANTHROPIC_BASE_URL: "", HTTPS_PROXY: "", HTTP_PROXY: "", ALL_PROXY: "" },
+		});
+		const [exit, stdout, stderr] = await Promise.all([
+			child.exited,
+			new Response(child.stdout).text(),
+			new Response(child.stderr).text(),
+		]);
+		if (exit !== 0) throw new Error(`child ${mode} exit ${exit}: ${stderr}`);
+		expect(exit).toBe(0);
+		expect(stderr).toBe("");
+		const actual = JSON.parse(stdout);
+		const baseline = mode === "baseline",
+			bound = mode === "resolve" || mode === "reject";
+		expect(actual).toEqual({
+			before: { observed: bound ? 1 : 0, transported: baseline ? 1 : 0, timed: baseline ? 1 : 0, completed: !bound },
+			observed: bound ? 1 : 0,
+			transported: baseline ? 1 : 0,
+			timed: baseline ? 1 : 0,
+			completed: true,
+		});
+	});
+}
