+function observeStartupCatalogFetch(): FetchImpl {
+	const hook = (globalThis as Record<symbol, unknown>)[Symbol.for("context-foundry.startup.catalog-refusal.v1")];
+	if (typeof hook !== "function") throw new Error("Startup catalog observer unavailable");
+	return async (input, init) => {
+		const metadata =
+			input === "https://catalog.stencil.so/models.json.zstd" && init?.method === "GET"
+				? { owner: "model_catalog_discovery", method: "GET", origin: "https://catalog.stencil.so" }
+				: null;
+		await hook(metadata);
+		throw new Error("Startup catalog transport refused");
+	};
+}
