--- /dev/null
+++ b/packages/ai/src/auth/startup-empty.ts
@@ -0,0 +1,122 @@
+/** The explicit empty pilot profile, not a general credential/OAuth lifecycle. */
+const metadata: Record<string, readonly string[]> = {
+	oauth: ["identity"],
+	usage: ["observe"],
+	credentials: ["providers", "credentials", "get", "list", "has", "hasOAuth", "hasSubscription", "getOAuth", "all"],
+	keys: ["source", "keyless", "describe"],
+};
+const admitted: Record<string, readonly string[]> = {
+	credentials: ["reload", "onDisabled", "onGeneration"],
+	keys: ["prefetchUsage", "setResolver", "clearConfig", "removeConfig", "removeRuntime"],
+	sessions: ["inherit"],
+	usage: ["removeProvider"],
+};
+export class EmptyStartupAuth {
+	#state: "open" | "closing" | "closed" = "open";
+	#failed = false;
+	#pending = new Set<Promise<void>>();
+	#operations = 0;
+	#rejections = 0;
+	#namespaces = new WeakMap<object, object>();
+	constructor(
+		private readonly checkEmpty: () => void,
+		private readonly checkCache: () => void,
+	) {}
+	refuse(): never {
+		this.#failed = true;
+		throw new Error("Empty startup auth operation or material refused");
+	}
+	abort(): void {
+		if (this.#state !== "closed") {
+			this.#failed = true;
+			this.#state = "closed";
+		}
+	}
+	assertOpen(): void {
+		if (this.#state !== "open" || this.#failed) this.refuse();
+	}
+	own<T>(start: () => T): T {
+		this.assertOpen();
+		this.checkEmpty();
+		if (this.#operations === 4096) this.refuse();
+		this.#operations++;
+		let original: T;
+		try {
+			original = start();
+		} catch (error) {
+			this.#rejections++;
+			throw error;
+		}
+		if (original instanceof Promise) {
+			const completion = Promise.allSettled([original]).then(([outcome]) => {
+				if (outcome.status === "rejected") this.#rejections++;
+				this.#pending.delete(completion);
+			});
+			this.#pending.add(completion);
+		}
+		return original;
+	}
+	wrap<T extends object>(name: string, target: T): T {
+		const previous = this.#namespaces.get(target);
+		if (previous) return previous as T;
+		const methods = new Map<PropertyKey, { original: unknown; wrapped: (...args: unknown[]) => unknown }>();
+		const proxy = new Proxy(target, {
+			get: (receiver, property) => {
+				const value = Reflect.get(receiver, property, receiver);
+				if (typeof value !== "function") return value;
+				const previous = methods.get(property);
+				if (previous?.original === value) return previous.wrapped;
+				const sourceOf = (provider: unknown) => {
+					const method: unknown = Reflect.get(receiver, "source", receiver);
+					if (typeof method !== "function") return this.refuse();
+					return Reflect.apply(method, receiver, [provider, { env: "aliases" }]);
+				};
+				const wrapped = (...args: unknown[]) => {
+					this.checkCache();
+					const key = typeof property === "string" ? property : "";
+					// Source metadata reads do not start auth work and remain available after close.
+					if (metadata[name]?.includes(key)) {
+						if (name === "keys" && typeof args[0] === "string" && sourceOf(args[0]) !== undefined) this.refuse();
+						return Reflect.apply(value, receiver, args);
+					}
+					if (!admitted[name]?.includes(key)) this.refuse();
+					if (
+						name === "keys" &&
+						key === "prefetchUsage" &&
+						(typeof args[0] !== "string" || sourceOf(args[0]) !== undefined)
+					)
+						this.refuse();
+					return this.own(() => Reflect.apply(value, receiver, args));
+				};
+				methods.set(property, { original: value, wrapped });
+				return wrapped;
+			},
+			set: () => this.refuse(),
+			defineProperty: () => this.refuse(),
+			deleteProperty: () => this.refuse(),
+			setPrototypeOf: () => this.refuse(),
+		});
+		this.#namespaces.set(target, proxy);
+		return proxy;
+	}
+	async retire(closeOriginal: () => void) {
+		this.assertOpen();
+		this.#state = "closing";
+		await Promise.resolve();
+		while (this.#pending.size) await Promise.all([...this.#pending]);
+		if (this.#failed || this.#state !== "closing") this.refuse();
+		this.checkEmpty();
+		this.checkCache();
+		closeOriginal();
+		this.#state = "closed";
+		return Object.freeze({
+			empty_auth: true as const,
+			auth_retired: true as const,
+			originals_joined: true as const,
+			callbacks_joined: true as const,
+			store_closed: true as const,
+			operations: this.#operations,
+			rejections: this.#rejections,
+		});
+	}
+}
