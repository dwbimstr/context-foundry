@@ -0,0 +1,249 @@
+import { afterEach, expect, spyOn, test } from "bun:test";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { type AuthCredentialStore, AuthStorage, SqliteAuthCredentialStore } from "@oh-my-pi/pi-ai";
+import { resolveAuthBrokerConfig } from "@oh-my-pi/pi-ai/auth-broker/discover";
+import { recordCredentialPin } from "../src/session/credential-pin";
+import { SessionManager } from "../src/session/session-manager";
+const roots: string[] = [];
+afterEach(() => {
+	for (const p of roots.splice(0)) fs.rmSync(p, { recursive: true, force: true });
+});
+async function fixture(owned = true) {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "startup-empty-auth-"));
+	roots.push(root);
+	const store = await SqliteAuthCredentialStore.open(path.join(root, "auth.db"));
+	return { root, store, auth: new AuthStorage(store, { startupEmptyAuth: owned }) };
+}
+async function turns() {
+	for (let i = 0; i < 20; i++) await Promise.resolve();
+}
+test("retirement owns the exact original namespace promise and a held callback", async () => {
+	const f = await fixture(),
+		keys = f.auth.keys,
+		proto = Object.getPrototypeOf(keys),
+		original = proto.prefetchUsage,
+		gate = Promise.withResolvers<void>();
+	let captured: Promise<void> | undefined;
+	const spy = spyOn(proto, "prefetchUsage").mockImplementation(function (this: unknown, ...args: unknown[]) {
+		captured = (async () => {
+			await Reflect.apply(original, this, args);
+			await gate.promise;
+		})();
+		return captured;
+	});
+	try {
+		const pending = keys.prefetchUsage("anthropic");
+		expect(pending).toBe(captured!);
+		let done = false;
+		const retirement = f.auth.retireStartupEmptyAuth().then(r => {
+			done = true;
+			return r;
+		});
+		await turns();
+		expect(done).toBe(false);
+		f.store.assertEmptyStartup();
+		expect(() => keys.prefetchUsage("anthropic")).toThrow("refused");
+		// Late operations are rejected, but do not reopen the owner. Use another fixture
+		// below for the successful receipt, since violations invalidate this attempt.
+		gate.resolve();
+		await pending;
+		await expect(retirement).rejects.toThrow("refused");
+	} finally {
+		gate.resolve();
+		spy.mockRestore();
+		f.auth.close();
+	}
+});
+test("a successful held original finishes before the native store closes", async () => {
+	const f = await fixture(),
+		keys = f.auth.keys,
+		proto = Object.getPrototypeOf(keys),
+		original = proto.prefetchUsage,
+		gate = Promise.withResolvers<void>();
+	let captured: Promise<void> | undefined;
+	const spy = spyOn(proto, "prefetchUsage").mockImplementation(function (this: unknown, ...args: unknown[]) {
+		captured = (async () => {
+			await Reflect.apply(original, this, args);
+			await gate.promise;
+		})();
+		return captured;
+	});
+	try {
+		const pending = keys.prefetchUsage("anthropic");
+		expect(pending).toBe(captured!);
+		let done = false;
+		const retirement = f.auth.retireStartupEmptyAuth().then(r => {
+			done = true;
+			return r;
+		});
+		await turns();
+		expect(done).toBe(false);
+		f.store.assertEmptyStartup();
+		gate.resolve();
+		await pending;
+		const receipt = await retirement;
+		expect(receipt).toEqual({
+			empty_auth: true,
+			auth_retired: true,
+			originals_joined: true,
+			callbacks_joined: true,
+			store_closed: true,
+			operations: 1,
+			rejections: 0,
+		});
+		f.store.assertStartupClosed();
+		expect(keys.source("anthropic")).toBeUndefined();
+		expect(() => keys.prefetchUsage("anthropic")).toThrow("refused");
+		await expect(f.auth.retireStartupEmptyAuth()).rejects.toThrow("refused");
+	} finally {
+		gate.resolve();
+		spy.mockRestore();
+		f.auth.close();
+	}
+});
+test("original rejection stays visible, joins and closes the empty native store", async () => {
+	const f = await fixture(),
+		keys = f.auth.keys,
+		proto = Object.getPrototypeOf(keys),
+		failure = Error("synthetic original failure");
+	const spy = spyOn(proto, "prefetchUsage").mockImplementation(() => Promise.reject(failure));
+	try {
+		await expect(keys.prefetchUsage("anthropic")).rejects.toBe(failure);
+		const r = await f.auth.retireStartupEmptyAuth();
+		expect(r.rejections).toBe(1);
+		f.store.assertStartupClosed();
+	} finally {
+		spy.mockRestore();
+		f.auth.close();
+	}
+});
+test("fixed profile rejects material before adopting it, ordinary auth retains it", async () => {
+	const f = await fixture(false);
+	await f.auth.credentials.set("synthetic", { type: "api_key", key: "synthetic-local-only" });
+	expect(() => new AuthStorage(f.store, { startupEmptyAuth: true })).toThrow("must be empty");
+	f.auth.close();
+});
+test("broker exclusion precedes config command and token resolution", async () => {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "startup-broker-refusal-"));
+	roots.push(root);
+	fs.writeFileSync(
+		path.join(root, "config.yml"),
+		"auth:\n  broker:\n    url: '!never-run'\n    token: '!never-run'\n",
+	);
+	let calls = 0;
+	await expect(
+		resolveAuthBrokerConfig({
+			agentDir: root,
+			requireEmptyAuth: true,
+			configValueResolver: async () => {
+				calls++;
+				throw Error("must not resolve");
+			},
+		}),
+	).rejects.toThrow("refuses broker");
+	expect(calls).toBe(0);
+});
+test("credential mutation, resolver and usage work are refused before callbacks", async () => {
+	const f = await fixture();
+	let calls = 0;
+	f.auth.keys.setResolver(async () => {
+		calls++;
+		return "synthetic-local-only";
+	});
+	expect(() => f.auth.keys.setConfig("synthetic", "!never-run")).toThrow("refused");
+	expect(() => f.auth.keys.get("synthetic")).toThrow("refused");
+	expect(() => f.auth.usage.reports()).toThrow("refused");
+	expect(() => f.auth.oauth.refresh(0)).toThrow("refused");
+	expect(calls).toBe(0);
+	await expect(f.auth.retireStartupEmptyAuth()).rejects.toThrow("refused");
+	f.auth.close();
+});
+test("unowned auth refuses the new receipt and preserves normal credentials", async () => {
+	const f = await fixture(false);
+	f.auth.keys.setRuntime("synthetic", "synthetic-local-only");
+	expect(await f.auth.keys.get("synthetic")).toBe("synthetic-local-only");
+	await expect(f.auth.retireStartupEmptyAuth()).rejects.toThrow("unavailable");
+	f.auth.close();
+});
+
+test("foreign backend is rejected before an empty-profile wrapper can be created", async () => {
+	const f = await fixture(false);
+	expect(() => new AuthStorage(f.auth as unknown as AuthCredentialStore, { startupEmptyAuth: true })).toThrow(
+		"original local SQLite",
+	);
+	f.auth.close();
+});
+test("ordinary broker resolution remains live outside the empty profile", async () => {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "startup-broker-positive-"));
+	roots.push(root);
+	fs.writeFileSync(
+		path.join(root, "config.yml"),
+		"auth:\n  broker:\n    url: '!owned-url'\n    token: '!owned-token'\n",
+	);
+	let calls = 0;
+	const result = await resolveAuthBrokerConfig({
+		agentDir: root,
+		configValueResolver: async value => {
+			calls++;
+			return value.includes("url") ? "http://127.0.0.1:9" : "synthetic-local-only";
+		},
+	});
+	expect(result?.url).toBe("http://127.0.0.1:9");
+	expect(calls).toBe(2);
+});
+
+test("a fresh namespace lookup observes a replaced original method", async () => {
+	const f = await fixture(),
+		keys = f.auth.keys,
+		old = keys.prefetchUsage,
+		proto = Object.getPrototypeOf(keys),
+		real = proto.prefetchUsage,
+		gate = Promise.withResolvers<void>();
+	let captured: Promise<void> | undefined;
+	const spy = spyOn(proto, "prefetchUsage").mockImplementation(function (this: unknown, ...args: unknown[]) {
+		captured = (async () => {
+			await Reflect.apply(real, this, args);
+			await gate.promise;
+		})();
+		return captured;
+	});
+	try {
+		expect(keys.prefetchUsage).not.toBe(old);
+		const p = keys.prefetchUsage("anthropic");
+		expect(p).toBe(captured!);
+		let done = false;
+		const retirement = f.auth.retireStartupEmptyAuth().then(r => {
+			done = true;
+			return r;
+		});
+		await turns();
+		expect(done).toBe(false);
+		gate.resolve();
+		await p;
+		await retirement;
+		f.store.assertStartupClosed();
+	} finally {
+		gate.resolve();
+		spy.mockRestore();
+		f.auth.close();
+	}
+});
