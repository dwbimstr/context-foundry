+test("retired empty auth preserves the native completion consumer without credential IO", async () => {
+	const f = await fixture();
+	await f.auth.keys.prefetchUsage("anthropic");
+	await f.auth.retireStartupEmptyAuth();
+	const manager = SessionManager.inMemory(f.root);
