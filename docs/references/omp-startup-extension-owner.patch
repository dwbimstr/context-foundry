@@ -0,0 +1,106 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+const src = join(import.meta.dir, "../src");
+function run(body: string, beforeOwner = "") {
+	const dir = mkdtempSync(join(tmpdir(), "foundry-extension-test-"));
+	const init = `
+ const r=await import(${JSON.stringify(join(src, "extensibility/extensions/runner.ts"))});
+ const l=await import(${JSON.stringify(join(src, "extensibility/extensions/loader.ts"))});
+ const {EventBus}=await import(${JSON.stringify(join(src, "utils/event-bus.ts"))});
+ const {SessionManager}=await import(${JSON.stringify(join(src, "session/session-manager.ts"))});
+ const {AuthStorage}=await import(${JSON.stringify(join(src, "session/auth-storage.ts"))});
+ const {ModelRegistry}=await import(${JSON.stringify(join(src, "config/model-registry.ts"))});
+ const {Settings}=await import(${JSON.stringify(join(src, "config/settings.ts"))});
+ const {logger}=await import('@oh-my-pi/pi-utils'); logger.setTransports({file:false,console:false});
+ const dir=${JSON.stringify(dir)};const auth=await AuthStorage.create(dir+'/auth.db');const registry=new ModelRegistry(auth);
+ const runtime=new l.ExtensionRuntime();let handler=async()=>{};
+ const extension=await l.loadExtensionFromFactory(pi=>{pi.on('session_start',async()=>await handler())},dir,new EventBus(),runtime);
+ const runner=new r.ExtensionRunner([extension],runtime,dir,SessionManager.inMemory(dir),registry,undefined,Settings.isolated());
+ ${beforeOwner}
+ const owner=r.ownStartupExtension();r.bindStartupExtension(owner,runner);
+ let receipt=null,forgedRejected=false;globalThis[Symbol.for('context-foundry.startup.extension-settled.v1')]=proof=>{try{r.consumeStartupExtensionReceipt({})}catch{forgedRejected=true}receipt=r.consumeStartupExtensionReceipt(proof)};
+ `;
+	try {
+		const p = Bun.spawnSync([process.execPath, "-e", init + body], {
+			stdout: "pipe",
+			stderr: "pipe",
+			cwd: src + "/..",
+		});
+		if (p.exitCode !== 0) throw Error(p.stderr.toString());
+		return JSON.parse(p.stdout.toString());
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+}
+test("original handler and observer finish before exact receipt, and late dispatch is closed", () => {
+	const v = run(`
+  let release,entered=false,finished=false,starts=0;const held=new Promise(r=>release=r);
+  handler=async()=>{starts++;entered=true;r.readyStartupExtension(owner,runner);await held;finished=true};
+  const emission=runner.emit({type:'session_start'});for(let i=0;i<100&&!entered;i++)await new Promise(r=>setTimeout(r,1));
+  const before=receipt===null&&!finished;release();await emission;
+  let repeat=false,add=false,forged=false;try{await runner.emit({type:'session_start'})}catch{repeat=true}
+  try{await runner.addExtensions([extension])}catch{add=true}try{r.consumeStartupExtensionReceipt({})}catch{forged=true}
+  console.log(JSON.stringify({before,finished,repeat,add,forged,forgedRejected,starts,receipt}));auth.close();
+ `);
+	expect(v).toEqual({
+		before: true,
+		finished: true,
+		repeat: true,
+		add: true,
+		forged: true,
+		forgedRejected: true,
+		starts: 1,
+		receipt: { handlers_joined: true, callbacks_joined: true, starts_closed: true, handlers: 1 },
+	});
+});
+test("timeout cannot attest while original ignores abort; after release it still fails", () => {
+	const v = run(`
+  let release,entered=false,finished=false,settled=false;const held=new Promise(r=>release=r);
+  handler=async()=>{entered=true;r.readyStartupExtension(owner,runner);await held;finished=true};r.testSetExtensionHandlerTimeoutMs(20);
+  const emission=runner.emit({type:'session_start'}).then(()=>{settled=true;return 'ok'},()=>{settled=true;return 'failed'});
+  for(let i=0;i<100&&!entered;i++)await new Promise(r=>setTimeout(r,1));await new Promise(r=>setTimeout(r,80));
+  const before=!settled&&!finished&&receipt===null;release();const outcome=await emission;
+  console.log(JSON.stringify({before,finished,outcome,receipt}));auth.close();
+ `);
+	expect(v).toEqual({ before: true, finished: true, outcome: "failed", receipt: null });
+});
+test("a failed handler and an unready owner cannot attest", () => {
+	for (const body of [
+		"handler=async()=>{r.readyStartupExtension(owner,runner);throw Error('synthetic')};",
+		"handler=async()=>{};",
+	]) {
+		const v = run(
+			`${body} let rejected=false;try{await runner.emit({type:'session_start'})}catch{rejected=true}console.log(JSON.stringify({rejected,receipt}));auth.close();`,
+		);
+		expect(v).toEqual({ rejected: true, receipt: null });
+	}
+});
+test("CLI flag is valueless and forged SDK owner is rejected", async () => {
+	const { parseArgs } = await import("../src/cli/args");
+	const { VALUELESS_FLAGS } = await import("../src/cli/flag-tables");
+	const { createAgentSession } = await import("../src/sdk");
+	const args = parseArgs([
+		"--startup-extension",
+		"--model",
+		"synthetic/model",
+		"--restrict-tools",
+		"--tools",
+		"read,edit",
+	]);
+	expect(args.startupExtension).toBe(true);
+	expect(args.model).toBe("synthetic/model");
+	expect(VALUELESS_FLAGS.has("--startup-extension")).toBe(true);
+	await expect(
+		createAgentSession({ restrictToolNames: true, startupExtensionOwner: { kind: "startup-extension" } }),
+	).rejects.toThrow("exact restricted CLI owner");
+});
+
+test("ownership refuses a previous session_start dispatch", () => {
+	const result = run(
+		"",
+		`await runner.emit({type:'session_start'});let late=false;try{r.ownStartupExtension()}catch{late=true}console.log(JSON.stringify({late}));auth.close();process.exit(0);`,
+	);
+	expect(result).toEqual({ late: true });
+});
