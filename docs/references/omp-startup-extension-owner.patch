+export interface StartupExtensionOwner {
+	readonly kind: "startup-extension";
+}
+let unownedSessionStarts = 0;
+let startupExtension:
+	| {
+			handle: StartupExtensionOwner;
+			runner?: WeakRef<ExtensionRunner>;
+			phase: "open" | "dispatching" | "closed" | "failed";
+			ready: boolean;
+			failed: boolean;
+			pending: Set<Promise<void>>;
+			handlers: number;
+			receipt?: object;
+			consumed: boolean;
+	  }
+	| undefined;
+export function ownStartupExtension(): StartupExtensionOwner {
+	if (startupExtension || unownedSessionStarts) throw new Error("Startup extension ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-extension" as const });
+	startupExtension = {
+		handle,
+		phase: "open",
+		ready: false,
+		failed: false,
+		pending: new Set(),
+		handlers: 0,
+		consumed: false,
+	};
+	return handle;
+}
+export function isStartupExtension(handle: unknown): handle is StartupExtensionOwner {
+	return (
+		!!startupExtension &&
+		startupExtension.handle === handle &&
+		startupExtension.phase === "open" &&
+		!startupExtension.runner
+	);
+}
+export function bindStartupExtension(handle: unknown, runner: unknown): void {
+	const owner = startupExtension;
+	if (
+		!owner ||
+		owner.handle !== handle ||
+		owner.phase !== "open" ||
+		owner.runner ||
+		!(runner instanceof ExtensionRunner)
+	)
+		throw new Error("Startup extension runner identity mismatch");
+	owner.runner = new WeakRef(runner);
+}
+export function readyStartupExtension(handle: unknown, runner: unknown): void {
+	const owner = startupExtension;
+	if (
+		!owner ||
+		owner.handle !== handle ||
+		owner.runner?.deref() !== runner ||
+		owner.phase !== "dispatching" ||
+		owner.ready
+	)
+		throw new Error("Startup extension readiness mismatch");
+	owner.ready = true;
+}
+export function consumeStartupExtensionReceipt(receipt: unknown) {
+	const owner = startupExtension;
+	if (!owner || owner.phase !== "closed" || owner.receipt !== receipt || owner.consumed)
+		throw new Error("Startup extension receipt mismatch");
+	owner.consumed = true;
+	return owner.receipt;
+}
+function trackStartupHandler(owner: NonNullable<typeof startupExtension>, original: Promise<unknown>): void {
+	if (++owner.handlers > 64) {
+		owner.failed = true;
+		throw new Error("Startup extension handler limit");
+	}
+	const observer = original.then(
+		() => {
+			owner.pending.delete(observer);
+		},
+		() => {
+			owner.failed = true;
+			owner.pending.delete(observer);
+		},
+	);
+	owner.pending.add(observer);
+}
