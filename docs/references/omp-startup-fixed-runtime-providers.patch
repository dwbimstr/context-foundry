+
+test("fixed startup rejects runtime registration before a callback and keeps the fault", async () => {
+	const clean = fixture(true, true);
+	const refused = fixture(true, true);
+	try {
+		clean.registry.assertStartupRuntimeProvidersExcluded();
+		await expect(clean.registry.retireStartupDiscovery()).resolves.toMatchObject({ discovery_retired: true });
+		let callbacks = 0;
+		for (const id of ["anthropic", "startup-runtime-fixture"]) {
+			expect(() =>
+				refused.registry.registerProvider(id, {
+					fetchDynamicModels: async () => {
+						callbacks++;
+						return [];
+					},
+				}),
+			).toThrow("Fixed startup profile refuses runtime provider registration");
+		}
+		await refused.registry.refreshRuntimeProviders("online");
+		expect(callbacks).toBe(0);
+		expect(refused.fetches()).toBe(0);
+		refused.registry.assertStartupRuntimeProvidersExcluded();
+		await expect(refused.registry.retireStartupDiscovery()).rejects.toThrow("native owner unqualified");
+	} finally {
+		clean.close();
+		refused.close();
+	}
+});
