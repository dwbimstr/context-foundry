+function fixture(owned = true) {
+	const dir = fs.mkdtempSync(path.join(os.tmpdir(), "startup-registry-owner-")),
+		auth = createInMemoryAuthStorage();
+	let fetches = 0;
+	const registry = new ModelRegistry(auth, path.join(dir, "models.yml"), {
+		ownStartupDiscovery: owned,
+		fetch: () => {
+			fetches++;
+			return Promise.reject(Error("synthetic transport refusal"));
+		},
+	});
+	return {
+		registry,
+		auth,
+		dir,
+		fetches: () => fetches,
+		close() {
+			auth.close();
+			fs.rmSync(dir, { recursive: true, force: true });
+		},
+	};
+}
