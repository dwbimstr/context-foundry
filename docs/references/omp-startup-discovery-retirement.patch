+test("a detached catalog subscriber cannot retire the shared original payload", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<Response>(),
+		controller = new AbortController();
+	let called = false;
+	const fetchImpl = startupDiscoveryFetch(() => {
+		called = true;
+		return gate.promise;
+	}, owner);
+	const request = fetchWellKnownModels(fetchImpl, controller.signal);
+	expect(called).toBe(true);
+	controller.abort(new Error("owned subscriber aborted"));
+	await expect(request).rejects.toThrow("subscriber aborted");
+	let retired = false;
+	const retirement = owner.retire().then(r => {
+		retired = true;
+		return r;
+	});
+	await turns();
+	expect(retired).toBe(false);
+	gate.resolve(Response.json({}));
+	await retirement;
+	expect(retired).toBe(true);
+});
