@@ -0,0 +1,81 @@
+import type { FetchImpl } from "../types";
+
+export type DiscoveryOperationOwner = <T>(operation: () => Promise<T>) => Promise<T>;
+export interface StartupDiscoveryReceipt {
+	readonly discovery_retired: true;
+	readonly originals_joined: true;
+	readonly callbacks_joined: true;
+	readonly timers_retired: true;
+	readonly operations: number;
+	readonly rejections: number;
+}
+
+/** One opt-in registry's concrete discovery calls; never a transport permission. */
+export class StartupDiscovery {
+	#state: "open" | "closing" | "closed" = "open";
+	#pending = new Set<Promise<void>>();
+	#operations = 0;
+	#rejections = 0;
+	#overflow = false;
+	assertOpen(): void {
+		if (this.#state !== "open") throw new Error("Startup discovery admission closed");
+	}
+	/** Internal continuations of admitted work may finish while retirement joins them. */
+	own: DiscoveryOperationOwner = <T>(operation: () => Promise<T>): Promise<T> => {
+		if (this.#state === "closed") throw new Error("Startup discovery retired");
+		if (this.#operations === 4096) {
+			this.#overflow = true;
+			throw new Error("Startup discovery operation bound exceeded");
+		}
+		this.#operations++;
+		let original: Promise<T>;
+		try {
+			original = operation();
+		} catch (error) {
+			this.#rejections++;
+			throw error;
+		}
+		const observer = original.then(
+			() => {},
+			() => {
+				this.#rejections++;
+			},
+		);
+		const joined = Promise.allSettled([original, observer]).then(() => {
+			this.#pending.delete(joined);
+		});
+		this.#pending.add(joined);
+		return original;
+	};
+	async retire(): Promise<StartupDiscoveryReceipt> {
+		this.assertOpen();
+		this.#state = "closing";
+		// A synchronous factory may request retirement reentrantly before returning
+		// its original promise; let that stack register it before the first join.
+		await Promise.resolve();
+		while (this.#pending.size) await Promise.allSettled([...this.#pending]);
+		this.#state = "closed";
+		if (this.#overflow) throw new Error("Startup discovery ownership unqualified");
+		return Object.freeze({
+			discovery_retired: true,
+			originals_joined: true,
+			callbacks_joined: true,
+			timers_retired: true,
+			operations: this.#operations,
+			rejections: this.#rejections,
+		});
+	}
+}
+
+// Existing catalog sessions are already scoped by fetch identity. Carry this
+// registry's owner through those same concrete source calls, without global hooks.
+const owners = new WeakMap<FetchImpl, StartupDiscovery>();
+export function startupDiscoveryFetch(fetchImpl: FetchImpl, owner: StartupDiscovery): FetchImpl {
+	const wrapped: FetchImpl = (...args) => owner.own(() => fetchImpl(...args));
+	owners.set(wrapped, owner);
+	return wrapped;
+}
+export function ownDiscovery<T>(fetchImpl: FetchImpl | undefined, operation: () => Promise<T>): Promise<T> {
+	const owner = fetchImpl && owners.get(fetchImpl);
+	return owner ? owner.own(operation) : operation();
+}
