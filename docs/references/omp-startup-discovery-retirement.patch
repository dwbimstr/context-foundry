+test("configured discovery retains a response body that ignores its abort", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<{ data: unknown[] }>();
+	let signal: AbortSignal | undefined;
+	const response = Response.json({});
+	Object.defineProperty(response, "json", { value: () => gate.promise });
+	const fetchImpl = startupDiscoveryFetch((_input, init) => {
+		signal = init?.signal as AbortSignal;
+		return Promise.resolve(response);
+	}, owner);
+	const discovery = discoverModelsByProviderType(
+		{
+			provider: "owned-fixture",
+			api: "openai-completions",
+			baseUrl: "http://127.0.0.1:9",
+			discovery: { type: "openai-models-list", timeoutMs: 5 },
+		},
+		{ fetch: fetchImpl, getBearerApiKeyResolver: async () => undefined },
+	);
+	await expect(discovery).rejects.toThrow();
+	expect(signal?.aborted).toBe(true);
+	let done = false;
+	const retirement = owner.retire().then(r => {
+		done = true;
+		return r;
+	});
+	await turns();
+	expect(done).toBe(false);
+	gate.resolve({ data: [] });
+	await retirement;
+	expect(done).toBe(true);
+});
