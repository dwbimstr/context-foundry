+		f.registry.refreshInBackground("offline");
+		const receipt = await f.registry.retireStartupDiscovery();
+		expect(receipt.operations).toBeGreaterThan(0);
+		expect(receipt.timers_retired).toBe(true);
+		const before = f.fetches();
+		for (const restart of [
+			() => f.registry.refresh("online"),
+			() => f.registry.refreshIfStale(),
+			() => f.registry.hydrateCredentialScopedModelCaches(),
+			() => f.registry.reapplyModelPolicies(),
+			() => f.registry.refreshProvider("owned-fixture", "online"),
+			() => f.registry.refreshDiscoverableProviders(["owned-fixture"], "online"),
+			() => f.registry.refreshRuntimeProviders("online"),
+			() => f.registry.refreshInBackground("online"),
+		])
+			expect(restart).toThrow("admission closed");
+		expect(() => f.registry.subscribeMirror(() => {})).toThrow("admission closed");
+		expect(f.fetches()).toBe(before);
+		await expect(f.registry.retireStartupDiscovery()).rejects.toThrow("admission closed");
+	} finally {
+		f.close();
+	}
+});
