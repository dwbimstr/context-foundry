+import { expect, test } from "bun:test";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { StartupDiscovery, startupDiscoveryFetch } from "@oh-my-pi/pi-catalog/provider-models/startup-discovery";
+import { fetchWellKnownModels } from "@oh-my-pi/pi-catalog/provider-models/openai-compat";
+import { withModelDiscoveryTimeout } from "../src/config/model-provider-discovery";
+import { discoverModelsByProviderType } from "../src/config/model-discovery";
+import { ModelRegistry } from "../src/config/model-registry";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+async function turns() {
+	for (let i = 0; i < 12; i++) await Promise.resolve();
+}
+
+test("retirement joins the exact original after its timeout returns", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<number>();
+	const identity = Promise.resolve(7);
+	const direct = owner.own(() => identity);
+	expect(direct).toBe(identity);
+	const timed = withModelDiscoveryTimeout(5, () => gate.promise, owner.own);
+	await expect(timed).rejects.toThrow("model discovery timed out");
+	let retired = false;
+	const retirement = owner.retire().then(r => {
+		retired = true;
+		return r;
+	});
+	await turns();
+	expect(retired).toBe(false);
+	gate.resolve(7);
+	expect(await direct).toBe(7);
+	const receipt = await retirement;
+	expect(receipt.originals_joined).toBe(true);
+	expect(retired).toBe(true);
+	expect(() => owner.own(() => Promise.resolve(1))).toThrow("retired");
+	await expect(owner.retire()).rejects.toThrow("closed");
+});
+
+test("primary failure does not discard an admitted original or its error identity", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<void>(),
+		primary = new Error("primary");
+	const body = owner.own(async () => {
+		owner.own(() => gate.promise);
+		throw primary;
+	});
+	try {
+		await body;
+		throw Error("expected primary");
+	} catch (error) {
+		expect(error).toBe(primary);
+	}
+	let retired = false;
+	const retirement = owner.retire().then(r => {
+		retired = true;
+		return r;
+	});
+	await turns();
+	expect(retired).toBe(false);
+	gate.resolve();
+	const r = await retirement;
+	expect(r.rejections).toBe(1);
+});
+
+test("a reentrant retirement waits for its original factory to register", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<void>();
+	let retirement: Promise<unknown> | undefined;
+	owner.own(() => {
+		retirement = owner.retire();
+		return gate.promise;
+	});
+	let done = false;
+	retirement!.then(() => {
+		done = true;
+	});
+	await turns();
+	expect(done).toBe(false);
+	gate.resolve();
+	await retirement;
+	expect(done).toBe(true);
+});
+
+test("original rejection remains visible despite a fulfilled completion observer", async () => {
+	const owner = new StartupDiscovery(),
+		failure = new Error("original");
+	const p = owner.own(() => Promise.reject(failure));
+	try {
+		await p;
+		throw Error("expected original");
+	} catch (error) {
+		expect(error).toBe(failure);
+	}
+	expect((await owner.retire()).rejections).toBe(1);
+});
+
+test("an exhausted owner drains admitted work and publishes no retirement receipt", async () => {
+	const owner = new StartupDiscovery(),
+		gate = Promise.withResolvers<void>();
+	owner.own(() => gate.promise);
+	for (let i = 1; i < 4096; i++) owner.own(() => Promise.resolve());
+	let invoked = false;
+	expect(() =>
+		owner.own(() => {
+			invoked = true;
+			return Promise.resolve();
+		}),
