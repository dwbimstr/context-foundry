+import { expect, test } from "bun:test";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+const base = new URL("../src/", import.meta.url).pathname;
+const helper = new URL("./helpers/agent-session-setup.ts", import.meta.url).pathname;
+const program = `
+import { parseArgs } from ${JSON.stringify(base + "cli/args.ts")};
+import { VALUELESS_FLAGS } from ${JSON.stringify(base + "cli/flag-tables.ts")};
+import { buildSessionOptions } from ${JSON.stringify(base + "main.ts")};
+import { createAgentSession, sealRestrictedStartup } from ${JSON.stringify(base + "sdk.ts")};
+import { ModelRegistry } from ${JSON.stringify(base + "config/model-registry.ts")};
+import { Settings } from ${JSON.stringify(base + "config/settings.ts")};
+import { SessionManager } from ${JSON.stringify(base + "session/session-manager.ts")};
+import { createInMemoryAuthStorage } from ${JSON.stringify(helper)};
+const mode=process.argv[1], cwd=process.env.CF_RESTRICTED_WORKSPACE;
+process.chdir(cwd);
+const auth=createInMemoryAuthStorage();
+const registry=new ModelRegistry(auth,cwd+'/models.yml');
+registry.registerProvider('restriction-fixture',{baseUrl:'http://127.0.0.1:9',api:'openai-completions',apiKey:'synthetic-local-only',models:[{id:'synthetic',name:'Synthetic',reasoning:false,input:['text'],cost:{input:0,output:0,cacheRead:0,cacheWrite:0},contextWindow:8192,maxTokens:1024}]},'<restriction-fixture>');
+const settings=Settings.isolated();settings.setModelRole('default','restriction-fixture/synthetic');
+const manager=SessionManager.inMemory(cwd);
+const flags=[...(mode==='missing-tools'?[]:['--tools','read,edit']),'--no-context-files','--no-skills','--no-rules','--no-title','--no-lsp','--no-pty'];
+if(mode!=='baseline') flags.push('--restrict-tools');
+const parsed=parseArgs(flags);
+let options;
+try{options=await buildSessionOptions(parsed,[],manager,registry,settings,()=>{});}
+catch(error){if(mode==='missing-tools' && error.message==='--restrict-tools requires --tools'){auth.close();console.log(JSON.stringify({invalidToolsRefused:true}));process.exit(0);}throw error;}
+if(mode==='missing-tools') throw Error('missing tool list accepted');
+Object.assign(options,{cwd,agentDir:cwd,authStorage:auth,modelRegistry:registry,settings,sessionManager:manager,model:registry.find('restriction-fixture','synthetic'),disableExtensionDiscovery:true,extensions:[],skills:[],rules:[],contextFiles:[],promptTemplates:[],slashCommands:[],skipPythonPreflight:true,enableLsp:false,enableMCP:mode==='inherited'});
+let inheritedReads=0;
+if(mode==='inherited') Object.defineProperty(options,'mcpManager',{get(){inheritedReads++;throw Error('inherited MCP must not be read');}});
+const result=await createAgentSession(options);
+let wrongManager=false,wrongRegistry=false,duplicate=false,late=false,ambiguous=false,disposedRefused=false,sealed,second;
+if(mode==='identity') {try{sealRestrictedStartup({},registry);}catch{wrongManager=true;}try{sealRestrictedStartup(manager,{});}catch{wrongRegistry=true;}}
+if(mode==='ambiguous') {
+ second=await createAgentSession({...options,agentId:'second-fixture',sessionManager:SessionManager.inMemory(cwd)});
+ try{sealRestrictedStartup(manager,registry);}catch{ambiguous=true;}
+}
+if(mode==='disposed'){await result.session.dispose();try{sealRestrictedStartup(manager,registry);}catch{disposedRefused=true;}}
+if(mode!=='baseline' && mode!=='ambiguous' && mode!=='disposed') {
+ sealed=sealRestrictedStartup(manager,registry);
+ try{sealRestrictedStartup(manager,registry);}catch{duplicate=true;}
+ if(mode==='late') {try{await createAgentSession(options);}catch{late=true;}}
+}
+const output={mode,flagClassified:VALUELESS_FLAGS.has('--restrict-tools'),restrict:options.restrictToolNames===true,memoryEnabled:result.session.memoryEnabled,receipt:result.startupRestrictions??null,sealed:sealed??null,inheritedReads,wrongManager,wrongRegistry,duplicate,late,ambiguous,disposedRefused};
+if(second) await second.session.dispose();
+await result.session.dispose();registry.clearSourceRegistrations('<restriction-fixture>');auth.close();
+console.log(JSON.stringify(output));
+`;
+for (const mode of [
+	"baseline",
+	"restricted",
+	"inherited",
+	"identity",
+	"late",
+	"ambiguous",
+	"missing-tools",
+	"disposed",
+]) {
+	test(`CLI restriction reaches real SDK session: ${mode}`, async () => {
+		const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cli-restricted-startup-"));
+		try {
+			const child = Bun.spawn([process.execPath, "-e", program, mode], {
+				env: { ...process.env, CF_RESTRICTED_WORKSPACE: dir },
+				stdout: "pipe",
+				stderr: "pipe",
+			});
+			const [exit, stdout, stderr] = await Promise.all([
+				child.exited,
+				new Response(child.stdout).text(),
+				new Response(child.stderr).text(),
+			]);
+			if (exit !== 0) throw new Error(`child ${mode} exit ${exit}: ${stderr}`);
+			expect(stderr).toBe("");
+			if (mode === "missing-tools") {
+				expect(JSON.parse(stdout)).toEqual({ invalidToolsRefused: true });
+				return;
+			}
+			const value = JSON.parse(stdout),
+				restricted = mode !== "baseline";
+			expect(value.flagClassified).toBe(true);
+			expect(value.restrict).toBe(restricted);
+			expect(value.memoryEnabled).toBe(!restricted);
+			expect(value.inheritedReads).toBe(0);
+			const receipt = { tool_names: ["edit", "read"], mcp_disabled: true, memory_disabled: true };
+			expect(value.receipt).toEqual(restricted ? receipt : null);
+			expect(value.sealed).toEqual(
+				restricted && mode !== "ambiguous" && mode !== "disposed"
+					? { ...receipt, credential_usage_joined: true }
+					: null,
+			);
+			expect(value.duplicate).toBe(restricted && mode !== "ambiguous" && mode !== "disposed");
+			expect(value.disposedRefused).toBe(mode === "disposed");
+			expect(value.ambiguous).toBe(mode === "ambiguous");
+			expect(value.late).toBe(mode === "late");
+			expect(value.wrongManager).toBe(mode === "identity");
+			expect(value.wrongRegistry).toBe(mode === "identity");
+		} finally {
+			fs.rmSync(dir, { recursive: true, force: true });
+		}
+	}, 15000);
+}
