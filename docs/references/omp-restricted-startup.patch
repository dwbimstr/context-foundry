+/** Source-owned result of the SDK's actual restricted initialization. */
+export interface RestrictedStartupReceipt {
+	readonly tool_names: readonly string[];
+	readonly mcp_disabled: true;
+	readonly memory_disabled: true;
+}
+export interface SealedRestrictedStartupReceipt extends RestrictedStartupReceipt {
+	readonly credential_usage_joined: true;
+}
+let restrictedStarts = 0;
+let restrictedSealed = false;
+let restrictedOwner:
+	| { session: WeakRef<AgentSession>; registry: WeakRef<ModelRegistry>; receipt: SealedRestrictedStartupReceipt }
+	| undefined;
+
+/** One-use binding for the fixed CLI's exact manager and registry. */
+export function sealRestrictedStartup(sessionManager: unknown, modelRegistry: unknown): SealedRestrictedStartupReceipt {
+	const owner = restrictedOwner;
+	const session = owner?.session.deref();
+	if (
+		restrictedSealed ||
+		restrictedStarts !== 1 ||
+		!owner ||
+		!session ||
+		session.isDisposed ||
+		session.sessionManager !== sessionManager ||
+		owner.registry.deref() !== modelRegistry ||
+		session.memoryEnabled ||
+		JSON.stringify(session.getActiveToolNames().slice().sort()) !== JSON.stringify(owner.receipt.tool_names)
+	) {
+		throw new Error("Restricted startup owner identity or state mismatch");
+	}
+	restrictedSealed = true;
+	return owner.receipt;
+}
