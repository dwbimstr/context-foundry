diff --git a/packages/coding-agent/test/startup-workspace-exclusion.test.ts b/packages/coding-agent/test/startup-workspace-exclusion.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/startup-workspace-exclusion.test.ts
@@ -0,0 +1,39 @@
+import { expect, test } from "bun:test";
+import { AuthStorage } from "@oh-my-pi/pi-ai";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ownStartupExtension } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/runner";
+import { createAgentSession } from "@oh-my-pi/pi-coding-agent/sdk";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+test("restricted startup refuses workspace scanning before a session can be returned", async () => {
+	using dir = TempDir.createSync("@omp-startup-workspace-");
+	const auth = await AuthStorage.create(dir.join("auth.db"));
+	const settings = Settings.isolated({ includeWorkspaceTree: true, "async.enabled": false });
+	const registry = new ModelRegistry(auth, dir.join("models.json"));
+	try {
+		await expect(
+			createAgentSession({
+				cwd: dir.path(),
+				agentDir: dir.path(),
+				modelRegistry: registry,
+				sessionManager: SessionManager.inMemory(dir.path()),
+				settings,
+				model: getBundledModel("openai", "gpt-4o-mini"),
+				disableExtensionDiscovery: true,
+				promptTemplates: [],
+				slashCommands: [],
+				enableMCP: false,
+				enableLsp: false,
+				toolNames: [],
+				restrictToolNames: true,
+				startupExtensionOwner: ownStartupExtension(),
+				skipPythonPreflight: true,
+			}),
+		).rejects.toThrow("Workspace tree scanning is unavailable during restricted startup");
+	} finally {
+		auth.close();
+	}
+});
