+test("restricted ownership excludes managed timeout and interval before native construction", () => {
+	const timerPath = join(src, "extensibility/extensions/managed-timers.ts");
+	const v = run(
+		`
+  let ticks=0,timeoutRejected=false,intervalRejected=false;
