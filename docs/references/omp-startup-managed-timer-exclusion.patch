+let managedTimerStarts = 0;
+let startupManagedTimersExcluded = false;
+/** Fail closed if any managed timer was scheduled before restricted startup ownership. */
+export function excludeStartupManagedTimers(): void {
+	if (startupManagedTimersExcluded || managedTimerStarts)
+		throw new Error("Startup managed timer exclusion is late or repeated");
+	startupManagedTimersExcluded = true;
+}
+function admitManagedTimer(): void {
+	if (startupManagedTimersExcluded) throw new Error("Startup managed timers are excluded");
+	managedTimerStarts = Math.min(2, managedTimerStarts + 1);
+}
