+	const failed = run(`
+  const owner=m.ownStartupPluginRoots();await m.preloadPluginRoots(dir,dir);m.registerPluginCacheInvalidator(()=>{throw Error('invalidation failed')});
+  let clearFailed=false,retirementFailed=false;try{m.clearClaudePluginRootsCache()}catch{clearFailed=true}
