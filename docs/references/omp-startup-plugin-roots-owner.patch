+function assertPluginRootsOpen(): void {
+	const owner = startupPluginRoots;
+	if (!owner) {
+		pluginRootStarts = Math.min(2, pluginRootStarts + 1);
+		return;
+	}
+	if (owner.phase !== "open") throw new Error("Startup plugin roots are closed");
+}
+function ownPluginRootsTask<T>(start: () => Promise<T>): Promise<T> {
+	const owner = startupPluginRoots;
+	if (!owner) {
+		pluginRootStarts = Math.min(2, pluginRootStarts + 1);
+		return start();
+	}
+	assertPluginRootsOpen();
+	if (++owner.operations > 4096) {
+		owner.failed = true;
+		throw new Error("Startup plugin roots operation limit");
+	}
+	let original: Promise<T>;
+	owner.activeSync++;
+	try {
+		original = start();
+	} catch (error) {
+		owner.failed = true;
+		throw error;
+	} finally {
+		owner.activeSync--;
+	}
+	const observer = original.then(
+		() => {
+			owner.pending.delete(observer);
+		},
+		() => {
+			owner.failed = true;
+			owner.pending.delete(observer);
+		},
+	);
+	owner.pending.add(observer);
+	return original;
+}
+function ownPluginRootsSync<T>(operation: () => T): T {
+	const owner = startupPluginRoots;
+	assertPluginRootsOpen();
+	if (!owner) return operation();
+	if (++owner.operations > 4096) {
+		owner.failed = true;
+		throw new Error("Startup plugin roots operation limit");
+	}
+	owner.activeSync++;
+	try {
+		return operation();
+	} catch (error) {
+		owner.failed = true;
+		throw error;
+	} finally {
+		owner.activeSync--;
+	}
+}
+/** Drain originals and their observers before atomically closing all entry points. */
+export async function retireStartupPluginRoots(handle: unknown) {
+	const owner = startupPluginRoots;
+	if (!owner || owner.handle !== handle || owner.phase !== "open" || owner.retiring || owner.activeSync !== 0)
+		throw new Error("Startup plugin roots identity or state mismatch");
+	owner.retiring = true;
+	while (owner.pending.size) await Promise.all(owner.pending);
+	owner.phase = "closed";
+	if (owner.failed || owner.operations < 1 || owner.operations > 4096)
+		throw new Error("Startup plugin roots did not settle");
