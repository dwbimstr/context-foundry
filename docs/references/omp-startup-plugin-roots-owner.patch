+export function ownStartupPluginRoots(): StartupPluginRootsOwner {
+	if (startupPluginRoots || pluginRootStarts) throw new Error("Startup plugin roots ownership is late or repeated");
+	const handle = Object.freeze({ kind: "startup-plugin-roots" as const });
