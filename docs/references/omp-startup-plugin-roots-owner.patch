+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+const helpersPath = join(import.meta.dir, "../src/discovery/helpers.ts");
+function run(code: string) {
+	const dir = mkdtempSync(join(tmpdir(), "foundry-plugin-test-"));
+	try {
+		const p = Bun.spawnSync(
+			[
+				process.execPath,
+				"-e",
+				`import * as m from ${JSON.stringify(helpersPath)}; import * as fs from 'node:fs'; const dir=${JSON.stringify(dir)};\n${code}`,
+			],
+			{ stdout: "pipe", stderr: "pipe" },
+		);
+		if (p.exitCode !== 0) throw Error(p.stderr.toString());
+		return JSON.parse(p.stdout.toString());
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+}
+test("holds real detached rewarm until original fs work and observer settle, then blocks cached entries", () => {
+	const result = run(`
+  fs.mkdirSync(dir+'/home',{recursive:true});fs.mkdirSync(dir+'/work',{recursive:true});
+  let invalidations=0;m.registerPluginCacheInvalidator(()=>invalidations++);const owner=m.ownStartupPluginRoots();await m.preloadPluginRoots(dir+'/home',dir+'/work');
+  const old=fs.promises.stat;let entered=false,release;const held=new Promise(r=>release=r);
+  fs.promises.stat=async (...args)=>{if(!entered){entered=true;await held;}return await Reflect.apply(old,fs.promises,args)};
+  const clear=m.clearClaudePluginRootsCache, pre=m.preloadPluginRoots, list=m.listClaudePluginRoots, inject=m.injectPluginDirRoots, full=m.clearPluginRootsAndCaches;
+  clear(); for(let i=0;i<100&&!entered;i++)await new Promise(r=>setTimeout(r,5));if(!entered)throw Error('actual fs hold not reached');
+  let done=false;const retirement=m.retireStartupPluginRoots(owner).then(r=>{done=true;return r});
+  await new Promise(r=>setTimeout(r,10));const premature=done;release();fs.promises.stat=old;const receipt=await retirement;
+  const beforeInvalidations=invalidations;let denied=0;for(const f of [()=>clear(),()=>full(),()=>pre(dir+'/home',dir+'/work'),()=>list(dir+'/home',dir+'/work'),()=>inject(dir+'/home',[],dir+'/work')]){try{await f()}catch{denied++}}
+  let repeated=false;try{await m.retireStartupPluginRoots(owner)}catch{repeated=true}
+  console.log(JSON.stringify({premature,done,denied,repeated,receipt,beforeInvalidations,afterInvalidations:invalidations}));
+ `);
+	expect(result.premature).toBe(false);
+	expect(result.done).toBe(true);
+	expect(result.denied).toBe(5);
+	expect(result.afterInvalidations).toBe(result.beforeInvalidations);
+	expect(result.repeated).toBe(true);
+	expect(result.receipt.plugin_roots_closed).toBe(true);
+	expect(result.receipt.originals_joined).toBe(true);
+	expect(result.receipt.callbacks_joined).toBe(true);
+	expect(result.receipt.operations).toBeGreaterThanOrEqual(4);
+});
+test("wrong, repeated and late ownership are refused", () => {
+	const result = run(`
+  const owner=m.ownStartupPluginRoots();let wrong=false,repeat=false;
+  try{await m.retireStartupPluginRoots({kind:'startup-plugin-roots'})}catch{wrong=true}
+  try{m.ownStartupPluginRoots()}catch{repeat=true}
+  await m.preloadPluginRoots(dir,dir);await m.retireStartupPluginRoots(owner);
+  console.log(JSON.stringify({wrong,repeat}));
+ `);
+	expect(result).toEqual({ wrong: true, repeat: true });
+	const late = run(
+		`await m.listClaudePluginRoots(dir,dir);let refused=false;try{m.ownStartupPluginRoots()}catch{refused=true}console.log(JSON.stringify({refused}))`,
+	);
+	expect(late.refused).toBe(true);
+});
+test("CLI flag is valueless and forged SDK ownership is rejected", async () => {
+	const { parseArgs } = await import("../src/cli/args");
+	const { VALUELESS_FLAGS } = await import("../src/cli/flag-tables");
+	const { createAgentSession } = await import("../src/sdk");
+	const args = parseArgs([
+		"--startup-plugin-roots",
+		"--model",
+		"synthetic/model",
+		"--restrict-tools",
+		"--tools",
