+	]);
+	expect(args.startupPluginRoots).toBe(true);
+	expect(args.model).toBe("synthetic/model");
+	expect(VALUELESS_FLAGS.has("--startup-plugin-roots")).toBe(true);
+	await expect(
+		createAgentSession({ restrictToolNames: true, startupPluginRootsOwner: { kind: "startup-plugin-roots" } }),
