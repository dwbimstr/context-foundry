+/// One placed unit and its representation (`None` = lexical).
+#[cfg(feature = "semantic")]
+type Placed = ((String, u64, u64), Option<crate::neural::cache::CardKind>);
+
+/// EXPERIMENT (fusion / one score, not for merge): reciprocal rank fusion,
+/// k = 60, over `(unit, kind, list, rank in list)` entries given in rank
+/// order within each list. A unit scores the sum of its best rank in each
+/// list and keeps its first dense representation; ties go to the better
+/// single rank, then the lower list.
+#[cfg(feature = "semantic")]
+fn experiment_rrf(
+    entries: Vec<(
+        (String, u64, u64),
+        Option<crate::neural::cache::CardKind>,
+        usize,
+        usize,
+    )>,
+    control: &crate::Control,
+) -> Vec<Placed> {
+    let mut slots = std::collections::HashMap::new();
+    // (score, best (rank, list), lists seen, unit, kind)
+    let mut fused: Vec<(f64, (usize, usize), u8, Placed)> = Vec::new();
+    let mut sizes = [0usize; 4];
+    for (unit, kind, list, rank) in entries {
+        sizes[list] += 1;
+        let score = 1.0 / (61.0 + rank as f64);
+        match slots.get(&unit) {
+            Some(&slot) => {
+                let entry: &mut (f64, (usize, usize), u8, Placed) = &mut fused[slot];
+                if entry.2 & (1 << list) == 0 {
+                    entry.2 |= 1 << list;
+                    entry.0 += score;
+                }
+                entry.1 = entry.1.min((rank, list));
+                if entry.3.1.is_none() {
+                    entry.3.1 = kind;
+                }
+            }
+            None => {
+                slots.insert(unit.clone(), fused.len());
+                fused.push((score, (rank, list), 1 << list, (unit, kind)));
+            }
+        }
+    }
+    fused.sort_by(|a, b| b.0.total_cmp(&a.0).then(a.1.cmp(&b.1)));
+    if let Some(trace) = control.trace() {
+        trace.record(serde_json::json!({"stage":"experiment_rrf", "lists":sizes,
+            "units":fused.len(), "multi":fused.iter().filter(|e| e.2.count_ones() > 1).count()}));
+    }
+    fused.into_iter().map(|entry| entry.3).collect()
+}
