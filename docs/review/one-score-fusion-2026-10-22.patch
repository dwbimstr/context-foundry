+/// EXPERIMENT (fusion, not for merge): `FOUNDRY_EXPERIMENT_FUSION=STORE,PROFILE`
+/// loads STORE's generation prepared for PROFILE (same model and query
+/// template as the serving profile). Any failure aborts the process, so a
+/// run can never silently measure the unfused arm.
+pub(crate) static FUSION: std::sync::LazyLock<Option<Arc<DenseIndex>>> =
+    std::sync::LazyLock::new(|| {
+        let spec = std::env::var("FOUNDRY_EXPERIMENT_FUSION").ok()?;
+        let fail = |what: String| -> ! {
+            eprintln!("FOUNDRY_EXPERIMENT_FUSION: {what}");
+            std::process::abort()
+        };
+        let Some((store, profile)) = spec.split_once(',') else {
+            fail("expected STORE,PROFILE".into())
+        };
+        let profile = SemanticProfile::load(std::path::Path::new(profile))
+            .unwrap_or_else(|e| fail(format!("profile: {e}")));
+        let engine = Engine::open_authoritative(std::path::Path::new(store))
+            .unwrap_or_else(|e| fail(format!("store: {e}")));
+        let index = DenseIndex::load(
+            &engine,
+            &profile.descriptor.digest(),
+            &profile.recipe_id(),
+            profile.descriptor.dims(),
+            &Control::unbounded(),
+        )
+        .unwrap_or_else(|e| fail(format!("generation: {e}")));
+        Some(index)
+    });
+
