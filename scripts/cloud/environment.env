# Context Foundry cloud environment variables. Paste into "Environment variables".
# Anyone using the environment can read these values, so never add a secret here.
# Paths are created by scripts/cloud/setup.sh; check them with scripts/cloud/doctor.sh.

# Rust 1.90.0 for every cargo command (the MSRV and the measurement toolchain).
RUSTUP_TOOLCHAIN=1.90.0
CARGO_TERM_COLOR=never
CARGO_INCREMENTAL=0
CARGO_PROFILE_DEV_DEBUG=0
CARGO_PROFILE_TEST_DEBUG=0

# Native llama.cpp workers (embed-worker, generate-worker).
LLAMA_CPP_DIR=/opt/cf/llama.cpp
BINDGEN_EXTRA_CLANG_ARGS="-isystem /usr/lib/gcc/x86_64-linux-gnu/13/include"

# Public pinned inputs (the setup script checks every SHA-256).
CONTEXT_FOUNDRY_013_CHECKPOINT=/opt/cf/laya-typed-decisions
CONTEXT_FOUNDRY_013_TOKENIZER=/opt/cf/laya-typed-decisions/tokenizer
CF_GEMMA_GGUF=/opt/cf/models/embeddinggemma-2-GGUF-bfcd2987/embeddinggemma-2-BF16.gguf
CF_GEMMA_TOKENIZER=/opt/cf/models/embeddinggemma-2-914f7f89/tokenizer.json
CF_GENERATION_GGUF=/opt/cf/models/Qwen2.5-Coder-0.5B-Instruct-GGUF-ebb20151/qwen2.5-coder-0.5b-instruct-q4_k_m.gguf

# Host-task runs (OMP 18.6.0 on Bun 1.3.14; Rust 1.90 rustc for the task checker).
FOUNDRY_OMP_BUN=/opt/cf/omp/node_modules/@oven/bun-linux-x64/bin/bun
FOUNDRY_OMP_CLI=/opt/cf/omp/node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js
FOUNDRY_HOST_RUSTC=/opt/cf/bin/rustc-1.90

# Private evidence, restored by scripts/cloud/fetch-resume.sh and its RESTORE.md.
CF_TOOLS=/workspace/.context-foundry-tools
V11=/workspace/.context-foundry-tools/validation-runs/realistic-delivery-v11
CF_RESUME_ASSET=context-foundry-resume-20261011.tar.gz
# Fill in after uploading the archive. Use ONE source: an HTTPS link that needs no
# credentials (e.g. a presigned S3/GCS/R2 URL), or a release asset in a private
# GitHub repository that is attached to the session.
CF_RESUME_URL=
CF_RESUME_GH_REPO=
CF_RESUME_GH_TAG=resume-20261011
# The first field of context-foundry-resume-20261011.tar.gz.sha256.
CF_RESUME_SHA256=

# Long builds, test suites and model runs: 30-minute foreground default, and up
# to 4 hours for a command Claude starts in the background with a timeout.
BASH_DEFAULT_TIMEOUT_MS=1800000
BASH_MAX_TIMEOUT_MS=14400000
