{
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace_id", "task_id", "command"],
  "properties": {
    "workspace_id": {"type": "string"},
    "task_id": {"type": "string"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "enum": ["create", "apply", "inspect", "peek", "render", "forget", "advise", "review", "promote", "search"]
        },
        "title": {"type": "string"},
        "expected_revision": {"type": "integer", "minimum": 0},
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {"enum": ["add", "select", "pin", "fold", "expand", "checkpoint", "restore", "dismiss"]},
              "entry": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "text", "author", "provenance", "source_links"],
                "properties": {
                  "id": {"type": "string"},
                  "kind": {
                    "enum": [
                      "requirement",
                      "constraint",
                      "observation",
                      "hypothesis",
                      "decision",
                      "rejected_attempt",
                      "question",
                      "work",
                      "artifact"
                    ]
                  },
                  "text": {"type": "string"},
                  "author": {"type": "string"},
                  "provenance": {"type": "string"},
                  "source_links": {"type": "array", "items": {"type": "string"}},
                  "supersedes": {"type": ["string", "null"]},
                  "action_key": {"type": ["string", "null"]},
                  "assertions": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["key", "relation", "value"],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
                        },
                        "relation": {"enum": ["equals", "not_equals"]},
                        "value": {"type": "string", "minLength": 1, "maxLength": 512}
                      }
                    }
                  }
                }
              },
              "entry_id": {"type": "string"},
              "selected": {"type": "boolean"},
              "pinned": {"type": "boolean"},
              "summary": {"type": "string"},
              "name": {"type": "string"}
            }
          },
          "minItems": 1,
          "maxItems": 32
        },
        "entry_id": {"type": "string"},
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "For peek, start at byte 0 or use the previous next_offset."
        },
        "bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 65536,
          "description": "Required page size for peek, in UTF-8 bytes."
        },
        "max_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "action_key": {"type": "string"},
        "paths": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
        "finishing": {"type": "boolean"},
        "memory_id": {"type": "string"},
        "author": {"type": "string"},
        "provenance": {"type": "string"},
        "query": {"type": "string", "minLength": 1, "maxLength": 256},
        "limit": {"type": "integer", "minimum": 1, "maximum": 32},
        "after_id": {"type": ["string", "null"]},
        "include_history": {"type": "boolean"},
        "assertions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "relation", "value"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
              },
              "relation": {"enum": ["equals"]},
              "value": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "inspect"}}}, "then": {"required": ["op"], "maxProperties": 1}},
        {
          "if": {"properties": {"op": {"const": "peek"}}},
          "then": {"required": ["op", "entry_id", "offset", "bytes"], "maxProperties": 4}
        }
      ]
    }
  }
}
